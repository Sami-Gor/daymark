+
+/// Synthesize already-phonemized IPA without invoking the English G2P.
+pub(super) async fn synth_phonemes<P, S>(
+    model: Weak<Mutex<Session>>,
+    phonemes: S,
+    pack: P,
+    voice: &Voice,
+    is_v11: bool,
+) -> Result<(Vec<f32>, Duration), KokoroError>
+where
+    P: AsRef<Vec<Vec<Vec<f32>>>>,
+    S: AsRef<str>,
+{
+    let chunks = chunk_phonemes(phonemes.as_ref(), MAX_PHONEME_CHARS);
     if chunks.is_empty() {
         return Ok((Vec::new(), Duration::ZERO));
     }
