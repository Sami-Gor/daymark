+#!/usr/bin/env bash
+# Plan B remediation regression suite (Round 7, agent B).
+#
+# Covers defect fixes B1 (--include-negative reversibility: targets.tsv,
+# restore --include-negative, hash verification), B2 (per-file pre-stage +
+# all-or-nothing commit + transactional rollback, partial-failure repair),
+# B3 (alternate recovery sources backup/extracted-new/archive), stale manifest
+# detection (A4/B3), repeated execution, and the canonical 30-check Plan B
+# verifier suite with byte-identical before/after hashes.
+#
+# All staging targets are APFS clones under the disposable T5 cache scratch; the
+# real repository/staged assets/quarantine/archives are only ever read.
+TEST_SUITE=plan-b
+export TEST_SUITE
+. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/test-lib.sh"
+
+suite_setup
+require_fixtures
+
+KIT="$KIT"
+LOG="$LOGS"
+
+t_info "kit: $KIT"
+t_info "scratch: $SCRATCH"
+
+# ---- fixture / production read-only snapshots ------------------------------
+hash_set "$NEW_EXTRACTED" "$SCRATCH/fixtures-new-pre.sha"
+hash_set "$OLD_EXTRACTED" "$SCRATCH/fixtures-old-pre.sha"
+shasum -a 256 "$OLD_ARCHIVE" "$NEW_ARCHIVE" > "$SCRATCH/archives-pre.sha"
+if [ -d "$STAGING_DIR" ]; then hash_set "$STAGING_DIR" "$SCRATCH/real-staging-pre.sha"; fi
+if [ -d "$NEGATIVE_STAGING_DIR" ]; then hash_set "$NEGATIVE_STAGING_DIR" "$SCRATCH/real-negative-pre.sha"; fi
+
+SYNTAX_FAIL=0
+for s in "$KIT"/*.sh "$KIT"/parakeet-pins.env "$KIT"/tests/*.sh; do bash -n "$s" || SYNTAX_FAIL=$((SYNTAX_FAIL + 1)); done
+assert_eq "all plan/remediation scripts + pins env parse (bash -n)" 0 "$SYNTAX_FAIL"
+
+if grep -q 'targets.tsv' "$KIT/apply-plan-b.sh" && grep -q 'targets.tsv' "$KIT/restore-staged-backup.sh"; then
+  t_pass "B1: targets.tsv target recording present in apply and restore"
+else
+  t_fail "B1: targets.tsv target recording missing"
+fi
+if grep -q -- '--include-negative' "$KIT/restore-staged-backup.sh"; then
+  t_pass "B1: restore-staged-backup.sh supports --include-negative"
+else
+  t_fail "B1: restore --include-negative missing"
+fi
+
+# ---- scratch repo + staging clones ----------------------------------------
+make_pin_repo "$SCRATCH/repo"
+git -C "$SCRATCH/repo" worktree add -q --detach "$SCRATCH/wt" 2>>"$LOG/setup.log" || t_fail "linked worktree fixture failed"
+STAGE="$SCRATCH/stage"
+NEG="$SCRATCH/stage-neg"
+B1="$SCRATCH/backup-main"
+new_staging "$STAGE"
+new_staging "$NEG"
+old_staging "$SCRATCH/old-ref"
+hash_set "$STAGE" "$SCRATCH/stage-before.sha"
+hash_set "$SCRATCH/old-ref" "$SCRATCH/old-ref.sha"
+
+# ---- 1. dry-run is side-effect free ---------------------------------------
+run_expect_ok "Plan B dry-run on NEW staging" "$LOG/dry.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B1"
+assert_grep "dry-run reports DRY-RUN OK" "DRY-RUN OK" "$LOG/dry.log"
+hash_set "$STAGE" "$SCRATCH/stage-after-dry.sha"
+assert_same_bytes "dry-run leaves staged bytes byte-identical" "$SCRATCH/stage-before.sha" "$SCRATCH/stage-after-dry.sha"
+
+# ---- 2. canonical apply + 30-check verifier ------------------------------
+run_expect_ok "Plan B apply: backup NEW then restore OLD" "$LOG/apply.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B1" --apply
+assert_grep "apply auto-verify reports 30/0" "checks passed: 30" "$LOG/apply.log"
+hash_set "$STAGE" "$SCRATCH/stage-old.sha"
+assert_same_bytes "applied staging bytes equal the canonical OLD set" "$SCRATCH/old-ref.sha" "$SCRATCH/stage-old.sha"
+
+run_expect_ok "explicit verify-plan-b run" "$LOG/verify.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B1"
+assert_counts "canonical Plan B suite (main staging + backup + archives) = 30 checks" "$LOG/verify.log" 30 0
+
+run_expect_ok "check-state classifies scratch Plan B as plan-b" "$LOG/check-old.log" \
+  "$KIT/check-state.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --expect old
+
+TARGET_ROWS=$(grep -c -v '^#' "$B1/targets.tsv" || true)
+assert_eq "B1: targets.tsv records exactly one target for a main-only run" 1 "$TARGET_ROWS"
+assert_grep "B1: targets.tsv records the staging path" "$SCRATCH/stage" "$B1/targets.tsv"
+BACKUP_FILES=$(ls "$B1/targets/t1" | grep -c -E '^(encoder|decoder|joiner)\.int8\.onnx$' || true)
+assert_eq "B1: backup preserves the 3 replaced NEW files (tokens shared -> not copied)" 3 "$BACKUP_FILES"
+assert_eq "B1: backup encoder bytes = canonical NEW" "$NEW_ENCODER_SHA256" "$(sha256_file "$B1/targets/t1/encoder.int8.onnx")"
+assert_eq "B1: backup decoder bytes = canonical NEW" "$NEW_DECODER_SHA256" "$(sha256_file "$B1/targets/t1/decoder.int8.onnx")"
+assert_eq "B1: backup joiner bytes = canonical NEW" "$NEW_JOINER_SHA256" "$(sha256_file "$B1/targets/t1/joiner.int8.onnx")"
+
+# ---- 3. reverse restore is byte-identical --------------------------------
+hash_set "$STAGE" "$SCRATCH/pre-restore.sha"
+run_expect_ok "restore dry-run on OLD staging" "$LOG/restore-dry.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B1"
+assert_grep "restore dry-run reports DRY-RUN OK" "DRY-RUN OK" "$LOG/restore-dry.log"
+hash_set "$STAGE" "$SCRATCH/post-restore-dry.sha"
+assert_same_bytes "restore dry-run leaves bytes unchanged" "$SCRATCH/pre-restore.sha" "$SCRATCH/post-restore-dry.sha"
+
+run_expect_ok "restore --apply returns the NEW bytes" "$LOG/restore.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B1" --apply
+hash_set "$STAGE" "$SCRATCH/restored.sha"
+assert_same_bytes "byte-identical before/after apply+restore cycle" "$SCRATCH/stage-before.sha" "$SCRATCH/restored.sha"
+run_expect_ok "check-state after restore classifies the known hazard" "$LOG/check-hazard.log" \
+  "$KIT/check-state.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --expect mixed
+
+
+# ---- 4. stale/tampered backup artifacts are refused (A4/B3) ---------------
+# Put staging OLD so verification reaches the backup checks.
+rm -rf "$STAGE"; old_staging "$STAGE"
+
+cp -cR "$B1" "$SCRATCH/backup-tamper-manifest" 2>/dev/null || cp -R "$B1" "$SCRATCH/backup-tamper-manifest"
+TM="$SCRATCH/backup-tamper-manifest/targets/t1/backup-manifest.tsv"
+awk 'BEGIN{OFS="\t"} $1=="encoder.int8.onnx"{$4="deadbeefdeadbeef"} {print}' "$TM" > "$TM.tmp" && mv -f "$TM.tmp" "$TM"
+run_expect_fail "stale/tampered backup manifest fails verify-plan-b" "$LOG/verify-stale-manifest.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-tamper-manifest" --no-archives
+assert_grep "stale manifest reason reported" "stale|mismatch" "$LOG/verify-stale-manifest.log"
+run_expect_fail "stale/tampered backup manifest refused by restore" "$LOG/restore-stale-manifest.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-tamper-manifest"
+assert_grep "restore refuses stale backup" "stale|tampered|refusing" "$LOG/restore-stale-manifest.log"
+
+cp -cR "$B1" "$SCRATCH/backup-tamper-bytes" 2>/dev/null || cp -R "$B1" "$SCRATCH/backup-tamper-bytes"
+cp -c -p "$OLD_EXTRACTED/encoder.int8.onnx" "$SCRATCH/backup-tamper-bytes/targets/t1/encoder.int8.onnx"
+run_expect_fail "tampered backup bytes fail verify-plan-b" "$LOG/verify-stale-bytes.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-tamper-bytes" --no-archives
+assert_grep "tampered byte reason reported" "sha256 mismatch|stale|tampered" "$LOG/verify-stale-bytes.log"
+run_expect_fail "tampered backup bytes refused by restore" "$LOG/restore-stale-bytes.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-tamper-bytes"
+
+cp -cR "$B1" "$SCRATCH/backup-tamper-targets" 2>/dev/null || cp -R "$B1" "$SCRATCH/backup-tamper-targets"
+printf 't9\t%s\tnew\n' "$SCRATCH/other-target" >> "$SCRATCH/backup-tamper-targets/targets.tsv"
+run_expect_fail "stale targets.tsv fails verify-plan-b" "$LOG/verify-stale-targets.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-tamper-targets" --no-archives
+assert_grep "targets mismatch reported" "target_count|mismatch" "$LOG/verify-stale-targets.log"
+
+# ---- 5. repeated execution and idempotence --------------------------------
+run_expect_fail "second apply on OLD staging refused without --idempotent" "$LOG/apply-twice-refused.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-should-not-exist" --apply
+assert_absent "refused second apply creates no backup dir" "$SCRATCH/backup-should-not-exist"
+
+rm -rf "$STAGE"; new_staging "$STAGE"
+B2="$SCRATCH/backup-repeat"
+run_expect_ok "repeat: fresh Plan B apply after restore" "$LOG/apply-repeat.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B2" --apply
+hash_set "$STAGE" "$SCRATCH/idem-before.sha"
+run_expect_ok "idempotent dry-run on already-OLD staging" "$LOG/apply-idem-dry.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-idem-dry" --idempotent
+run_expect_ok "idempotent --apply verifies only and writes nothing" "$LOG/apply-idem-apply.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-idem-apply" --idempotent --apply
+assert_absent "idempotent --apply creates no backup dir" "$SCRATCH/backup-idem-apply"
+hash_set "$STAGE" "$SCRATCH/idem-after.sha"
+assert_same_bytes "idempotent --apply leaves staged bytes byte-identical" "$SCRATCH/idem-before.sha" "$SCRATCH/idem-after.sha"
+
+# ---- 6. B3 alternate recovery sources -------------------------------------
+run_expect_ok "B3: restore from extracted-new source" "$LOG/restore-extracted-new.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B2" --source extracted-new --apply
+hash_set "$STAGE" "$SCRATCH/alt-new.sha"
+assert_same_bytes "B3: extracted-new restore returns canonical NEW bytes" "$SCRATCH/stage-before.sha" "$SCRATCH/alt-new.sha"
+
+rm -rf "$STAGE"; old_staging "$STAGE"
+run_expect_ok "B3: restore from NEW archive source" "$LOG/restore-archive.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B2" --source archive --apply
+hash_set "$STAGE" "$SCRATCH/alt-archive.sha"
+assert_same_bytes "B3: archive restore returns canonical NEW bytes" "$SCRATCH/stage-before.sha" "$SCRATCH/alt-archive.sha"
+
+rm -rf "$STAGE"; old_staging "$STAGE"
+run_expect_ok "B3: restore from backup source (default)" "$LOG/restore-backup.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$B2" --source backup --apply
+hash_set "$STAGE" "$SCRATCH/alt-backup.sha"
+assert_same_bytes "B3: backup restore returns canonical NEW bytes" "$SCRATCH/stage-before.sha" "$SCRATCH/alt-backup.sha"
+
+
+# ---- 7. B1 --include-negative: two targets, reversible --------------------
+rm -rf "$STAGE" "$NEG"; new_staging "$STAGE"; new_staging "$NEG"
+hash_set "$STAGE" "$SCRATCH/neg-main-before.sha"
+hash_set "$NEG" "$SCRATCH/neg-target-before.sha"
+BNEG="$SCRATCH/backup-negative"
+run_expect_ok "B1: apply --include-negative to main + negative targets" "$LOG/apply-negative.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --include-negative --negative-staging "$NEG" --backup-dir "$BNEG" --apply
+assert_grep "include-negative auto-verify reports 31/0" "checks passed: 31" "$LOG/apply-negative.log"
+run_expect_ok "B1: verify-plan-b --include-negative" "$LOG/verify-negative.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --include-negative --negative-staging "$NEG" --backup-dir "$BNEG"
+assert_counts "B1: include-negative verifier = 31 checks" "$LOG/verify-negative.log" 31 0
+ROWS=$(grep -c -v '^#' "$BNEG/targets.tsv" || true)
+assert_eq "B1: targets.tsv records both targets" 2 "$ROWS"
+assert_grep "B1: targets.tsv records the main target" "$SCRATCH/stage" "$BNEG/targets.tsv"
+assert_grep "B1: targets.tsv records the negative target" "$SCRATCH/stage-neg" "$BNEG/targets.tsv"
+T1F=$(ls "$BNEG/targets/t1" | grep -c -E '^(encoder|decoder|joiner)\.int8\.onnx$' || true)
+T2F=$(ls "$BNEG/targets/t2" | grep -c -E '^(encoder|decoder|joiner)\.int8\.onnx$' || true)
+assert_eq "B1: target t1 backup holds its 3 replaced files" 3 "$T1F"
+assert_eq "B1: target t2 backup holds its 3 replaced files (no namespace collision)" 3 "$T2F"
+hash_set "$NEG" "$SCRATCH/neg-main-old.sha"
+assert_same_bytes "B1: negative target staged bytes are now canonical OLD" "$SCRATCH/old-ref.sha" "$SCRATCH/neg-main-old.sha"
+
+run_expect_fail "B1: restore without --include-negative refuses a two-target backup" "$LOG/restore-negative-refused.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$BNEG"
+assert_grep "B1: refusal explains --include-negative" "include-negative" "$LOG/restore-negative-refused.log"
+run_expect_ok "B1: restore --include-negative --apply reverses both targets" "$LOG/restore-negative.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --include-negative --backup-dir "$BNEG" --apply
+hash_set "$STAGE" "$SCRATCH/neg-main-after.sha"
+hash_set "$NEG" "$SCRATCH/neg-target-after.sha"
+assert_same_bytes "B1: main target byte-identical after include-negative cycle" "$SCRATCH/neg-main-before.sha" "$SCRATCH/neg-main-after.sha"
+assert_same_bytes "B1: negative target byte-identical after include-negative cycle" "$SCRATCH/neg-target-before.sha" "$SCRATCH/neg-target-after.sha"
+
+# ---- 8. missing target directory: install then exact undo ------------------
+MISS="$SCRATCH/stage-missing"
+rm -rf "$MISS"
+BMISS="$SCRATCH/backup-missing"
+run_expect_ok "B2: apply into an absent staging dir (fresh checkout)" "$LOG/apply-missing.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$MISS" --backup-dir "$BMISS" --apply
+run_expect_ok "B2: verify an installed-from-absent target" "$LOG/verify-missing.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$MISS" --backup-dir "$BMISS"
+assert_counts "B2: missing-target verify = 30 checks" "$LOG/verify-missing.log" 30 0
+FCOUNT=$(ls "$MISS" 2>/dev/null | grep -c -E '\.(onnx|txt)$' || true)
+assert_eq "B2: absent target was populated with the 4 OLD files" 4 "$FCOUNT"
+run_expect_ok "B2: restore removes files that were absent before Plan B" "$LOG/restore-missing.log" \
+  "$KIT/restore-staged-backup.sh" --repo "$SCRATCH/repo" --staging "$MISS" --backup-dir "$BMISS" --apply
+LEFT=$(ls "$MISS" 2>/dev/null | grep -c -E '\.(onnx|txt)$' || true)
+assert_eq "B2: absent pre-state restored exactly (no model files remain)" 0 "$LEFT"
+
+# ---- 9. partial failure: commit rename fails, target untouched ------------
+rm -rf "$STAGE"; new_staging "$STAGE"
+hash_set "$STAGE" "$SCRATCH/partial-before.sha"
+make_mv_shim "$SCRATCH/shim"
+BFail="$SCRATCH/backup-partial-fail"
+rm -f "$SCRATCH/mv-shim-count"
+run_expect_fail "B2: injected rename failure aborts the install" "$LOG/apply-partial-fail.log" \
+  env PATH="$SCRATCH/shim:$PATH" MV_SHIM_COUNTER="$SCRATCH/mv-shim-count" MV_SHIM_FAIL_AT=2 \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$BFail" --apply
+assert_grep "B2: injected failure was seen by the script" "injected failure|rename failed" "$LOG/apply-partial-fail.log"
+hash_set "$STAGE" "$SCRATCH/partial-after.sha"
+assert_same_bytes "B2: partial failure leaves staged bytes byte-identical" "$SCRATCH/partial-before.sha" "$SCRATCH/partial-after.sha"
+assert_absent "B2: partial failure discards the just-created backup dir" "$BFail"
+assert_eq "B2: no pre-stage temp files leaked" "" "$(ls -a "$STAGE" | grep -E '^\.plan-b-tmp' || true)"
+run_expect_ok "B2: recovery apply after partial failure succeeds" "$LOG/apply-partial-recovery.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-partial-recovery" --apply
+run_expect_ok "B2: verify after recovery apply" "$LOG/verify-partial-recovery.log" \
+  "$KIT/verify-plan-b.sh" --repo "$SCRATCH/repo" --staging "$STAGE" --backup-dir "$SCRATCH/backup-partial-recovery"
+assert_counts "B2: recovery verify = 30 checks" "$LOG/verify-partial-recovery.log" 30 0
+
+# ---- 10. linked worktree is accepted by Plan B ----------------------------
+rm -rf "$STAGE"; new_staging "$STAGE"
+run_expect_ok "Plan B dry-run with --repo pointing at a linked worktree" "$LOG/dry-linked.log" \
+  "$KIT/apply-plan-b.sh" --repo "$SCRATCH/wt" --staging "$STAGE" --backup-dir "$SCRATCH/backup-linked"
+assert_grep "linked-worktree Plan B dry-run OK" "DRY-RUN OK" "$LOG/dry-linked.log"
+
+# ---- 11. production bytes unchanged by the suite -------------------------
+hash_set "$NEW_EXTRACTED" "$SCRATCH/fixtures-new-post.sha"
+hash_set "$OLD_EXTRACTED" "$SCRATCH/fixtures-old-post.sha"
+assert_same_bytes "production NEW extracted bytes unchanged by suite" "$SCRATCH/fixtures-new-pre.sha" "$SCRATCH/fixtures-new-post.sha"
+assert_same_bytes "production OLD extracted bytes unchanged by suite" "$SCRATCH/fixtures-old-pre.sha" "$SCRATCH/fixtures-old-post.sha"
+shasum -a 256 "$OLD_ARCHIVE" "$NEW_ARCHIVE" > "$SCRATCH/archives-post.sha"
+assert_same_bytes "preserved OLD/NEW archives unchanged by suite" "$SCRATCH/archives-pre.sha" "$SCRATCH/archives-post.sha"
+if [ -f "$SCRATCH/real-staging-pre.sha" ]; then
+  hash_set "$STAGING_DIR" "$SCRATCH/real-staging-post.sha"
+  assert_same_bytes "production staged model assets unchanged by suite" "$SCRATCH/real-staging-pre.sha" "$SCRATCH/real-staging-post.sha"
+fi
+if [ -f "$SCRATCH/real-negative-pre.sha" ]; then
+  hash_set "$NEGATIVE_STAGING_DIR" "$SCRATCH/real-negative-post.sha"
+  assert_same_bytes "production negative-worktree staged assets unchanged by suite" "$SCRATCH/real-negative-pre.sha" "$SCRATCH/real-negative-post.sha"
+fi
+
+suite_finish
diff --git a/tools/plan-remediation/tests/test-plans-remediation.sh b/tools/plan-remediation/tests/test-plans-remediation.sh
new file mode 100755
index 0000000..fc266c8
--- /dev/null
+++ b/tools/plan-remediation/tests/test-plans-remediation.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+# Round 7 Plan A/B remediation -- master regression runner.
+#
+# 1. static defect checks (each remediation is actually present in the shipped
+#    scripts, and the unsafe round-4 patterns are gone);
+# 2. Plan A regression suite (main worktree + linked worktree, positive/negative,
+#    rollback, missing staging, stale manifest, byte-identical revert);
+# 3. Plan B regression suite (backup/restore, include-negative, partial failure,
+#    repeated execution, stale manifests, alternate sources, byte-identical);
+# 4. canonical verifier suite counts: Plan A 55 checks, Plan B 30 checks.
+#
+# Usage: ./tests/test-plans-remediation.sh
+# Exit 0 only when every static check and both suites pass.
+set -uo pipefail
+TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
+KIT=$(cd "$TEST_DIR/.." && pwd -P)
+. "$KIT/parakeet-pins.env"
+. "$KIT/plans-lib.sh"
+
+ROOT=${PLANS_TEST_ROOT:-$T5/cache/round7/plans/test-run}
+RUNLOG="$ROOT/remediation-run-$(date -u +%Y%m%dT%H%M%SZ).log"
+mkdir -p "$ROOT"
+: > "$RUNLOG"
+
+PASS=0
+FAIL=0
+chk() { # name condition-result(0 ok)
+  if [ "$2" = 0 ]; then PASS=$((PASS + 1)); echo "STATIC PASS  $1"; else FAIL=$((FAIL + 1)); echo "STATIC FAIL  $1"; fi
+}
+has() { grep -q -E "$2" "$1"; }
+
+echo "== Static remediation checks ==" | tee -a "$RUNLOG"
+
+if has "$KIT/apply-plan-a.sh" 'git_repo_root' &&
+   ! grep -v '^[[:space:]]*#' "$KIT/apply-plan-a.sh" | grep -q '\[ -d "\$REPO/\.git" \]'; then
+  chk "A1 linked-worktree-safe repo root resolution in apply-plan-a.sh" 0
+else
+  chk "A1 linked-worktree-safe repo root resolution in apply-plan-a.sh" 1
+fi
+
+has "$KIT/apply-plan-a.sh" 'rollback_applied_patch'
+chk "A2 transactional rollback present in apply-plan-a.sh" $?
+
+has "$KIT/apply-plan-a.sh" 'pre-gate'
+chk "A2 archive failure pre-gate present in apply-plan-a.sh" $?
+
+has "$KIT/verify-plan-a.sh" 'allow-missing-staging'
+chk "A3 --allow-missing-staging implemented in verify-plan-a.sh" $?
+
+has "$KIT/refresh-evidence-manifest.sh" 'self-hash is impossible'
+chk "A4 stale evidence manifest regenerator/verifier present" $?
+
+has "$KIT/apply-plan-b.sh" 'BACKUP_TARGETS_TSV'
+chk "B1 targets.tsv multi-target backup layout present" $?
+
+has "$KIT/restore-staged-backup.sh" 'include-negative'
+chk "B1 restore --include-negative implemented" $?
+
+has "$KIT/apply-plan-b.sh" 'pre-staged'
+chk "B2 pre-stage + hash verification implemented" $?
+
+has "$KIT/apply-plan-b.sh" 'rollback_installed'
+chk "B2 transactional install rollback implemented" $?
+
+has "$KIT/restore-staged-backup.sh" 'extracted-new'
+chk "B3 alternate recovery source (extracted-new/archive) implemented" $?
+
+if grep -q -E '(^|[^a-z])(curl|wget)[[:space:]]' "$KIT"/*.sh 2>/dev/null ||
+   grep -q -E 'git[[:space:]]+(commit|push|merge|reset)[[:space:]]' "$KIT"/*.sh 2>/dev/null; then
+  chk "no network calls or git write commands in remediation scripts" 1
+else
+  chk "no network calls or git write commands in remediation scripts" 0
+fi
+
+SYNTAX_FAIL=0
+for s in "$KIT"/*.sh "$KIT"/parakeet-pins.env "$KIT"/tests/*.sh; do bash -n "$s" || SYNTAX_FAIL=$((SYNTAX_FAIL + 1)); done
+chk "every remediation script parses (bash -n)" "$SYNTAX_FAIL"
+echo | tee -a "$RUNLOG"
+
+echo "== Plan A regression suite ==" | tee -a "$RUNLOG"
+"$TEST_DIR/test-plan-a-suite.sh" > "$ROOT/plan-a-suite.out" 2>&1
+A_RC=$?
+grep -E '^(T-PASS|T-FAIL|SUITE RESULT)' "$ROOT/plan-a-suite.out" | tee -a "$RUNLOG"
+A_SUM=$(grep '^SUITE RESULT' "$ROOT/plan-a-suite.out" | tail -1)
+echo | tee -a "$RUNLOG"
+
+echo "== Plan B regression suite (long: real 639 MiB model bytes, APFS clones) ==" | tee -a "$RUNLOG"
+"$TEST_DIR/test-plan-b-suite.sh" > "$ROOT/plan-b-suite.out" 2>&1
+B_RC=$?
+grep -E '^(T-PASS|T-FAIL|SUITE RESULT)' "$ROOT/plan-b-suite.out" | tee -a "$RUNLOG"
+B_SUM=$(grep '^SUITE RESULT' "$ROOT/plan-b-suite.out" | tail -1)
+echo | tee -a "$RUNLOG"
+
+# ---- canonical verifier suite counts ---------------------------------------
+A_COUNTS="missing"; B_COUNTS="missing"
+if [ -f "$ROOT/plan-a/logs/verify-main.log" ]; then A_COUNTS=$(awk '/checks passed:/ {print $3" passed / "$5" failed"}' "$ROOT/plan-a/logs/verify-main.log"); fi
+if [ -f "$ROOT/plan-b/logs/verify.log" ]; then B_COUNTS=$(awk '/checks passed:/ {print $3" passed / "$5" failed"}' "$ROOT/plan-b/logs/verify.log"); fi
+
+echo "== Canonical suites ==" | tee -a "$RUNLOG"
+echo "Plan A verifier (55-check suite): $A_COUNTS" | tee -a "$RUNLOG"
+echo "Plan B verifier (30-check suite): $B_COUNTS" | tee -a "$RUNLOG"
+
+A_OK=0; B_OK=0
+[ "$A_COUNTS" = "55 passed / 0 failed" ] && A_OK=1
+[ "$B_COUNTS" = "30 passed / 0 failed" ] && B_OK=1
+chk "canonical Plan A 55-check suite is 55/0" "$((1 - A_OK))"
+chk "canonical Plan B 30-check suite is 30/0" "$((1 - B_OK))"
+echo
+
+if [ "$A_RC" = 0 ]; then chk "Plan A regression suite passed" 0; else chk "Plan A regression suite passed" 1; fi
+if [ "$B_RC" = 0 ]; then chk "Plan B regression suite passed" 0; else chk "Plan B regression suite passed" 1; fi
+
+echo "----------------------------------------" | tee -a "$RUNLOG"
+echo "TOTAL: static+suite checks passed=$PASS failed=$FAIL" | tee -a "$RUNLOG"
+echo "Plan A suite: $A_SUM" | tee -a "$RUNLOG"
+echo "Plan B suite: $B_SUM" | tee -a "$RUNLOG"
+echo "full output: $ROOT/plan-a-suite.out $ROOT/plan-b-suite.out" | tee -a "$RUNLOG"
+[ "$FAIL" = 0 ]
diff --git a/tools/plan-remediation/verify-plan-a.sh b/tools/plan-remediation/verify-plan-a.sh
new file mode 100755
index 0000000..a075ba9
--- /dev/null
+++ b/tools/plan-remediation/verify-plan-a.sh
@@ -0,0 +1,123 @@
+#!/usr/bin/env bash
+# Plan A verifier -- asserts a working tree is in the consistent NEW (Plan A)
+# state: all 24 coordinated literal edits in place, MODEL_VERSION sha256-2,
+# staged model bytes = new archive members, old archive preserved. Read-only.
+#
+# Remediation copy (Round 7, agent B):
+#   A1  --repo may be a linked worktree or subdirectory (pin files resolved at
+#       the git top level; plain non-git replicas still work).
+#   A3  new --allow-missing-staging: the documented fresh-checkout workflow
+#       (apply pins first, run fetch afterwards) now verifies cleanly instead
+#       of reporting 13 impossible staged-byte failures. This intentionally
+#       yields 42 checks instead of the 55 that run when staging is present.
+#
+# Canonical suite (staging present, archives verified): 55 checks.
+#
+# Usage: ./verify-plan-a.sh [--repo DIR] [--staging DIR] [--no-archives]
+#                           [--allow-missing-staging] [--quiet]
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd -P)
+. "$HERE/parakeet-pins.env"
+. "$HERE/plans-lib.sh"
+
+REPO=$REPO_ROOT
+STAGING=$STAGING_DIR
+WITH_ARCHIVES=1
+ALLOW_MISSING_STAGING=0
+QUIET=0
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --repo) REPO=$2; shift 2 ;;
+    --staging) STAGING=$2; shift 2 ;;
+    --no-archives) WITH_ARCHIVES=0; shift ;;
+    --allow-missing-staging) ALLOW_MISSING_STAGING=1; shift ;;
+    --quiet) QUIET=1; shift ;;
+    -h|--help) sed -n '2,18p' "$0"; exit 2 ;;
+    *) die "unknown argument: $1" ;;
+  esac
+done
+
+require_cmd shasum
+require_cmd grep
+
+REPO=$(repo_dir "$REPO")
+
+log "Verifying Plan A (NEW coordinated pin state) in $REPO"
+
+# 1. Global classification.
+check_eq "pin state is NEW (no old literals remain)" new "$(pins_state "$REPO")"
+
+# 2. Per-site literal placement (24 literal edits; tokens deliberately unchanged).
+check_eq "S1 fetch archive pin" 1 "$(count_literal "$REPO/$PIN_FETCH" "$NEW_ARCHIVE_SHA256")"
+check_eq "S2 fetch encoder pin" 1 "$(count_literal "$REPO/$PIN_FETCH" "$NEW_ENCODER_SHA256")"
+check_eq "S2 fetch decoder pin" 1 "$(count_literal "$REPO/$PIN_FETCH" "$NEW_DECODER_SHA256")"
+check_eq "S2 fetch joiner pin" 1 "$(count_literal "$REPO/$PIN_FETCH" "$NEW_JOINER_SHA256")"
+check_eq "S2 fetch tokens pin unchanged" 1 "$(count_literal "$REPO/$PIN_FETCH" "$NEW_TOKENS_SHA256")"
+check_eq "S3 build.gradle encoder digest" 1 "$(count_literal "$REPO/$PIN_GRADLE" "$NEW_ENCODER_SHA256")"
+check_eq "S3 build.gradle decoder digest" 1 "$(count_literal "$REPO/$PIN_GRADLE" "$NEW_DECODER_SHA256")"
+check_eq "S3 build.gradle joiner digest" 1 "$(count_literal "$REPO/$PIN_GRADLE" "$NEW_JOINER_SHA256")"
+check_eq "S3 build.gradle tokens digest unchanged" 1 "$(count_literal "$REPO/$PIN_GRADLE" "$NEW_TOKENS_SHA256")"
+check_eq "S4 ParakeetModelAssets encoder digest" 1 "$(count_literal "$REPO/$PIN_JAVA" "$NEW_ENCODER_SHA256")"
+check_eq "S4 ParakeetModelAssets decoder digest" 1 "$(count_literal "$REPO/$PIN_JAVA" "$NEW_DECODER_SHA256")"
+check_eq "S4 ParakeetModelAssets joiner digest" 1 "$(count_literal "$REPO/$PIN_JAVA" "$NEW_JOINER_SHA256")"
+check_eq "S4 ParakeetModelAssets tokens digest unchanged" 1 "$(count_literal "$REPO/$PIN_JAVA" "$NEW_TOKENS_SHA256")"
+check_eq "S4 ParakeetModelAssets encoder size" 1 "$(count_literal "$REPO/$PIN_JAVA" "${NEW_ENCODER_SIZE}L")"
+check_eq "S4 ParakeetModelAssets decoder size" 1 "$(count_literal "$REPO/$PIN_JAVA" "${NEW_DECODER_SIZE}L")"
+check_eq "S4 ParakeetModelAssets joiner size unchanged" 1 "$(count_literal "$REPO/$PIN_JAVA" "${NEW_JOINER_SIZE}L")"
+check_eq "S4 ParakeetModelAssets tokens size unchanged" 1 "$(count_literal "$REPO/$PIN_JAVA" "${NEW_TOKENS_SIZE}L")"
+check_eq "S4 MODEL_VERSION sha256-2" 1 "$(count_literal "$REPO/$PIN_JAVA" "$NEW_MODEL_VERSION")"
+check_eq "S4 old MODEL_VERSION absent" 0 "$(count_literal "$REPO/$PIN_JAVA" "$OLD_MODEL_VERSION")"
+check_eq "S5 test expected encoder size" 1 "$(count_literal "$REPO/$PIN_TEST" "${NEW_ENCODER_SIZE}L")"
+check_eq "S5 test expected decoder size" 1 "$(count_literal "$REPO/$PIN_TEST" "${NEW_DECODER_SIZE}L")"
+check_eq "S5 test expected joiner size unchanged" 1 "$(count_literal "$REPO/$PIN_TEST" "${NEW_JOINER_SIZE}L")"
+check_eq "S5 test expected tokens size unchanged" 1 "$(count_literal "$REPO/$PIN_TEST" "${NEW_TOKENS_SIZE}L")"
+check_eq "S6 notices archive digest (row + table)" 2 "$(count_literal "$REPO/$PIN_NOTICES" "$NEW_ARCHIVE_SHA256")"
+check_eq "S6 notices encoder digest" 1 "$(count_literal "$REPO/$PIN_NOTICES" "$NEW_ENCODER_SHA256")"
+check_eq "S6 notices decoder digest" 1 "$(count_literal "$REPO/$PIN_NOTICES" "$NEW_DECODER_SHA256")"
+check_eq "S6 notices joiner digest" 1 "$(count_literal "$REPO/$PIN_NOTICES" "$NEW_JOINER_SHA256")"
+check_eq "S6 notices tokens digest unchanged" 1 "$(count_literal "$REPO/$PIN_NOTICES" "$NEW_TOKENS_SHA256")"
+check_eq "S7 guide encoder digest" 1 "$(count_literal "$REPO/$PIN_GUIDE" "$NEW_ENCODER_SHA256")"
+check_eq "S7 guide decoder digest" 1 "$(count_literal "$REPO/$PIN_GUIDE" "$NEW_DECODER_SHA256")"
+check_eq "S7 guide joiner digest" 1 "$(count_literal "$REPO/$PIN_GUIDE" "$NEW_JOINER_SHA256")"
+check_eq "S7 guide archive digest" 1 "$(count_literal "$REPO/$PIN_GUIDE" "$NEW_ARCHIVE_SHA256")"
+check_eq "S7 guide tokens digest unchanged" 1 "$(count_literal "$REPO/$PIN_GUIDE" "$NEW_TOKENS_SHA256")"
+
+# 3. No old digest survives anywhere in the six files.
+check_eq "old archive digest absent" 0 "$(count_in_pins "$REPO" "$OLD_ARCHIVE_SHA256")"
+check_eq "old encoder digest absent" 0 "$(count_in_pins "$REPO" "$OLD_ENCODER_SHA256")"
+check_eq "old decoder digest absent" 0 "$(count_in_pins "$REPO" "$OLD_DECODER_SHA256")"
+check_eq "old joiner digest absent" 0 "$(count_in_pins "$REPO" "$OLD_JOINER_SHA256")"
+
+# 4. Staged bytes equal the Plan A target (must already be new; Plan A does not move model files).
+STAGED=$(staged_class "$STAGING")
+if [ "$STAGED" = missing ] && [ "$ALLOW_MISSING_STAGING" = 1 ]; then
+  warn "staged assets are missing; --allow-missing-staging given, so the 13 staged-byte checks are skipped"
+  note "run fetch-parakeet-assets.sh (or Plan B) before shipping; verify again without the flag"
+else
+  check_eq "staged model state is NEW" new "$STAGED"
+  for f in $MODEL_FILES; do
+    check_file "staged file present: $f" "$STAGING/$f"
+  done
+  check_eq "staged encoder size" "$NEW_ENCODER_SIZE" "$(file_size "$STAGING/encoder.int8.onnx")"
+  check_eq "staged encoder sha256" "$NEW_ENCODER_SHA256" "$(sha256_file "$STAGING/encoder.int8.onnx")"
+  check_eq "staged decoder size" "$NEW_DECODER_SIZE" "$(file_size "$STAGING/decoder.int8.onnx")"
+  check_eq "staged decoder sha256" "$NEW_DECODER_SHA256" "$(sha256_file "$STAGING/decoder.int8.onnx")"
+  check_eq "staged joiner size" "$NEW_JOINER_SIZE" "$(file_size "$STAGING/joiner.int8.onnx")"
+  check_eq "staged joiner sha256" "$NEW_JOINER_SHA256" "$(sha256_file "$STAGING/joiner.int8.onnx")"
+  check_eq "staged tokens size" "$NEW_TOKENS_SIZE" "$(file_size "$STAGING/tokens.txt")"
+  check_eq "staged tokens sha256" "$NEW_TOKENS_SHA256" "$(sha256_file "$STAGING/tokens.txt")"
+fi
+
+# 5. Archive evidence and preservation.
+if [ "$WITH_ARCHIVES" = 1 ]; then
+  check_archives
+fi
+
+echo
+if [ "$QUIET" -ne 1 ]; then
+  echo "Plan A state: pins NEW + staged NEW (consistent)."
+  echo "Not covered here (owner/build/device gates): fetch twice, verifyParakeetAssets,"
+  echo "bundleRelease/AAB member digests, model-dependent CI, on-device parity."
+fi
+summary
diff --git a/tools/plan-remediation/verify-plan-b.sh b/tools/plan-remediation/verify-plan-b.sh
new file mode 100755
index 0000000..c02f6f7
--- /dev/null
+++ b/tools/plan-remediation/verify-plan-b.sh
@@ -0,0 +1,222 @@
+#!/usr/bin/env bash
+# Plan B verifier -- asserts a working tree is in the consistent OLD (Plan B)
+# state: old pins + old staged bytes + MODEL_VERSION sha256-1, with the
+# pre-Plan-B bytes preserved in a backup dir. Read-only.
+#
+# Remediation copy (Round 7, agent B):
+#   A1  --repo may be a linked worktree or subdirectory.
+#   B1  backup verification is now target-aware (targets.tsv): every recorded
+#       target's manifest is checked, so an --include-negative backup can no
+#       longer hide a collided/overwritten target. Backup files are verified
+#       against the canonical NEW sizes/digests and against their manifest.
+#   A4/B3 stale manifests are detected: provenance stores the sha256 of
+#       targets.tsv and of every target manifest, so a stale or tampered
+#       manifest fails verification instead of being silently trusted.
+#
+# Canonical suite (main staging OLD + v2 backup + archives): 30 checks.
+#
+# Usage: ./verify-plan-b.sh [--repo DIR] [--staging DIR] [--backup-dir DIR]
+#                           [--include-negative] [--negative-staging DIR]
+#                           [--no-archives]
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd -P)
+. "$HERE/parakeet-pins.env"
+. "$HERE/plans-lib.sh"
+
+REPO=$REPO_ROOT
+STAGING=$STAGING_DIR
+BACKUP_DIR=""
+INCLUDE_NEGATIVE=0
+NEGATIVE_STAGING="$NEGATIVE_STAGING_DIR"
+WITH_ARCHIVES=1
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --repo) REPO=$2; shift 2 ;;
+    --staging) STAGING=$2; shift 2 ;;
+    --backup-dir) BACKUP_DIR=$2; shift 2 ;;
+    --include-negative) INCLUDE_NEGATIVE=1; shift ;;
+    --negative-staging) NEGATIVE_STAGING=$2; shift 2 ;;
+    --no-archives) WITH_ARCHIVES=0; shift ;;
+    -h|--help) sed -n '2,22p' "$0"; exit 2 ;;
+    *) die "unknown argument: $1" ;;
+  esac
+done
+
+require_cmd shasum
+require_cmd grep
+
+REPO=$(repo_dir "$REPO")
+STAGING=$(cd "$STAGING" 2>/dev/null && pwd -P) || STAGING=$STAGING
+
+log "Verifying Plan B (OLD staged assets restored, old pins) in $REPO"
+
+# ---------------------------------------------------------------------------
+# Backup layout helpers local to this verifier.
+backup_target_rows() { # -> id<TAB>path rows (legacy: single row t1 + STAGING)
+  local b=$1 layout
+  layout=$(backup_layout "$b")
+  if [ "$layout" = v2 ]; then
+    backup_read_targets "$b"
+  elif [ "$layout" = legacy ]; then
+    printf 't1\t%s\n' "$STAGING"
+  fi
+}
+
+backup_records_staging() { # backup-dir -> 0 when a recorded target path == STAGING
+  local b=$1 tid path pre
+  if [ "$(backup_layout "$b")" = legacy ]; then return 0; fi
+  while IFS=$'\t' read -r tid path pre; do
+    [ -n "$tid" ] || continue
+    if [ "$path" = "$STAGING" ]; then return 0; fi
+  done <<EOF
+$(backup_target_rows "$b")
+EOF
+  return 1
+}
+
+backup_target_for_negative() { # backup-dir -> path of the non-staging target (empty when absent)
+  local b=$1 tid path pre found=""
+  while IFS=$'\t' read -r tid path pre; do
+    [ -n "$tid" ] || continue
+    if [ "$path" != "$STAGING" ]; then found=$path; fi
+  done <<EOF
+$(backup_target_rows "$b")
+EOF
+  echo "$found"
+}
+
+check_backup_file() { # display-name file expected-sha expected-size
+  local disp=$1 f=$2 esha=$3 esize=$4 ok=1 seen=0 rows tid path pre0 tdir manifest entry pre size sha
+  rows=$(backup_target_rows "$BACKUP_DIR")
+  while IFS=$'\t' read -r tid path pre0; do
+    [ -n "$tid" ] || continue
+    if [ "$(backup_layout "$BACKUP_DIR")" = v2 ]; then
+      tdir="$BACKUP_DIR/targets/$tid"
+    else
+      tdir="$BACKUP_DIR"
+    fi
+    manifest="$tdir/$BACKUP_TARGET_MANIFEST"
+    [ -f "$manifest" ] || { ok=0; continue; }
+    entry=$(awk -F'\t' -v want="$f" '!/^#/ && $1==want {print; exit}' "$manifest" 2>/dev/null || true)
+    [ -n "$entry" ] || continue
+    seen=1
+    if [ "$(backup_layout "$BACKUP_DIR")" = v2 ]; then
+      pre=$(printf '%s' "$entry" | cut -f2)
+      size=$(printf '%s' "$entry" | cut -f3)
+      sha=$(printf '%s' "$entry" | cut -f4)
+      [ "$pre" = missing ] && continue
+    else
+      size=$(printf '%s' "$entry" | cut -f2)
+      sha=$(printf '%s' "$entry" | cut -f3)
+    fi
+    if [ "$sha" != "$esha" ] || [ "$size" != "$esize" ]; then ok=0; fi
+    if [ ! -f "$tdir/$f" ]; then ok=0; continue; fi
+    if [ "$(sha256_file "$tdir/$f")" != "$esha" ]; then ok=0; fi
+    if [ "$(file_size "$tdir/$f")" != "$esize" ]; then ok=0; fi
+  done <<EOF
+$rows
+EOF
+  if [ "$seen" = 0 ]; then
+    # tokens.txt is byte-identical in both states, so it is never replaced and
+    # needs no backup; every other canonical file must be recorded.
+    if [ "$f" = tokens.txt ]; then
+      pass "backup $disp (shared bytes; no replacement needed)"
+    else
+      fail "backup $disp (no manifest entry recorded)"
+    fi
+  elif [ "$ok" = 1 ]; then
+    pass "backup $disp (manifest + bytes = canonical NEW)"
+  else
+    fail "backup $disp (manifest or bytes do not match canonical NEW)"
+  fi
+}
+
+check_backup_manifests() { # combined: every recorded target manifest is exact
+  local rows tid path pre detail ok=1
+  rows=$(backup_target_rows "$BACKUP_DIR")
+  while IFS=$'\t' read -r tid path pre; do
+    [ -n "$tid" ] || continue
+    if ! detail=$(backup_check_manifest "$BACKUP_DIR" "$tid" 2>&1); then
+      ok=0
+      printf '%s\n' "$detail" | sed 's/^/      /'
+    fi
+  done <<EOF
+$rows
+EOF
+  if [ "$ok" = 1 ]; then
+    pass "backup manifests cover exactly the pre-Plan-B NEW bytes"
+  else
+    fail "backup manifests inconsistent (stale/tampered or incomplete)"
+  fi
+}
+# ---------------------------------------------------------------------------
+
+# 1. Pins must remain OLD.
+check_eq "pin state is OLD" old "$(pins_state "$REPO")"
+check_eq "MODEL_VERSION sha256-1 present" 1 "$(count_in_pins "$REPO" "$OLD_MODEL_VERSION")"
+check_eq "MODEL_VERSION sha256-2 absent" 0 "$(count_in_pins "$REPO" "$NEW_MODEL_VERSION")"
+check_eq "new archive digest absent from pins" 0 "$(count_in_pins "$REPO" "$NEW_ARCHIVE_SHA256")"
+check_eq "new encoder digest absent from pins" 0 "$(count_in_pins "$REPO" "$NEW_ENCODER_SHA256")"
+check_eq "new decoder digest absent from pins" 0 "$(count_in_pins "$REPO" "$NEW_DECODER_SHA256")"
+check_eq "new joiner digest absent from pins" 0 "$(count_in_pins "$REPO" "$NEW_JOINER_SHA256")"
+
+# 2. Main staging must be OLD bytes matching old pins exactly.
+check_eq "staged model state is OLD" old "$(staged_class "$STAGING")"
+for f in $MODEL_FILES; do
+  check_file "staged file present: $f" "$STAGING/$f"
+done
+check_eq "staged encoder size" "$OLD_ENCODER_SIZE" "$(file_size "$STAGING/encoder.int8.onnx")"
+check_eq "staged encoder sha256" "$OLD_ENCODER_SHA256" "$(sha256_file "$STAGING/encoder.int8.onnx")"
+check_eq "staged decoder size" "$OLD_DECODER_SIZE" "$(file_size "$STAGING/decoder.int8.onnx")"
+check_eq "staged decoder sha256" "$OLD_DECODER_SHA256" "$(sha256_file "$STAGING/decoder.int8.onnx")"
+check_eq "staged joiner size" "$OLD_JOINER_SIZE" "$(file_size "$STAGING/joiner.int8.onnx")"
+check_eq "staged joiner sha256" "$OLD_JOINER_SHA256" "$(sha256_file "$STAGING/joiner.int8.onnx")"
+check_eq "staged tokens size" "$OLD_TOKENS_SIZE" "$(file_size "$STAGING/tokens.txt")"
+check_eq "staged tokens sha256 (unchanged bytes)" "$OLD_TOKENS_SHA256" "$(sha256_file "$STAGING/tokens.txt")"
+
+# 3. Negative worktree when requested: must be OLD and recorded in the backup.
+if [ "$INCLUDE_NEGATIVE" = 1 ]; then
+  NEG_PATH=$NEGATIVE_STAGING
+  if [ -n "$BACKUP_DIR" ] && [ "$(backup_layout "$BACKUP_DIR")" = v2 ]; then
+    REC=$(backup_target_for_negative "$BACKUP_DIR")
+    if [ -n "$REC" ]; then NEG_PATH=$REC; else
+      warn "backup does not record a second (negative) target"
+      NEG_PATH="$NEGATIVE_STAGING/.missing-backup-target"
+    fi
+  fi
+  check_eq "negative target is OLD" old "$(staged_class "$NEG_PATH")"
+fi
+
+# 4. Pre-Plan-B bytes must be preserved for reversibility (6 checks).
+if [ -n "$BACKUP_DIR" ]; then
+  if [ ! -f "$BACKUP_DIR/$BACKUP_PROVENANCE_FILE" ]; then
+    fail "backup provenance present and consistent (missing: $BACKUP_DIR/$BACKUP_PROVENANCE_FILE)"
+  elif detail=$(backup_check_provenance "$BACKUP_DIR" 2>&1); then
+    if backup_records_staging "$BACKUP_DIR"; then
+      pass "backup provenance present and records the staging target(s) + manifest hashes"
+    else
+      fail "backup provenance does not record this staging target ($STAGING)"
+    fi
+  else
+    fail "backup provenance inconsistent (stale/tampered or wrong layout)"
+    printf '%s\n' "$detail" | sed 's/^/      /'
+  fi
+  check_backup_file "encoder (NEW)" encoder.int8.onnx "$NEW_ENCODER_SHA256" "$NEW_ENCODER_SIZE"
+  check_backup_file "decoder (NEW)" decoder.int8.onnx "$NEW_DECODER_SHA256" "$NEW_DECODER_SIZE"
+  check_backup_file "joiner (NEW)" joiner.int8.onnx "$NEW_JOINER_SHA256" "$NEW_JOINER_SIZE"
+  check_backup_file "tokens (NEW, shared bytes)" tokens.txt "$NEW_TOKENS_SHA256" "$NEW_TOKENS_SIZE"
+  check_backup_manifests
+fi
+
+# 5. Archive evidence.
+if [ "$WITH_ARCHIVES" = 1 ]; then
+  check_archives
+fi
+
+echo
+echo "Plan B state: pins OLD + staged OLD (consistent with ParakeetModelAssets,"
+echo "ParakeetModelAssetsTest, verifyParakeetAssets expectations)."
+echo "Caveat: old bytes are only reproducible from the preserved old archive;"
+echo "the upstream URL now serves the new archive, so fetch cannot recreate them."
+summary
