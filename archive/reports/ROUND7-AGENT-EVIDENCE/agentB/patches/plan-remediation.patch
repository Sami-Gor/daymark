@@ -0,0 +1,480 @@
+#!/usr/bin/env bash
+# Shared read-only helpers for the Parakeet Plan A/B rollout scripts.
+#
+# Remediation copy (Round 7, agent B). Behaviour is identical to
+# archive/reports/round4-b-plans/plans-lib.sh for every existing helper; the
+# additions are repo/worktree resolution, per-file classification, APFS-clone
+# copies, and Plan B backup-layout verification used by the fixed scripts.
+#
+# Sourced after parakeet-pins.env. No side effects at source time.
+
+PASS_COUNT=0
+FAIL_COUNT=0
+
+die()  { echo "ERROR: $*" >&2; exit 1; }
+warn() { echo "WARN:  $*" >&2; }
+log()  { echo "[*] $*"; }
+note() { echo "NOTE:  $*"; }
+pass() { PASS_COUNT=$((PASS_COUNT + 1)); echo "PASS  $*"; }
+fail() { FAIL_COUNT=$((FAIL_COUNT + 1)); echo "FAIL  $*"; }
+
+check_eq() { # name expected actual
+  if [ "$2" = "$3" ]; then pass "$1"; else fail "$1 (expected $2, got $3)"; fi
+}
+
+check_ne() { # name value forbidden
+  if [ "$2" != "$3" ]; then pass "$1"; else fail "$1 (forbidden value present: $3)"; fi
+}
+
+check_file() { # name path
+  if [ -f "$2" ]; then pass "$1"; else fail "$1 (missing: $2)"; fi
+}
+
+require_cmd() {
+  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
+}
+
+file_size() { # prints decimal byte size
+  wc -c < "$1" | tr -d ' '
+}
+
+sha256_file() {
+  shasum -a 256 "$1" | awk '{print $1}'
+}
+
+# ---------------------------------------------------------------------------
+# Repository / worktree resolution (defect A1).
+# A linked git worktree has a .git *file*, not a directory, so the round 4
+# preflight [ -d "$REPO/.git" ] rejected every worktree. Resolve through git
+# itself instead, and always operate on the repository top level (defect A1
+# repo-root handling: git apply is cwd-relative, so a subdirectory argument
+# must never be used as the apply root).
+# ---------------------------------------------------------------------------
+
+# repo_dir DIR -> absolute directory that holds the six pin files. Uses the git
+# top level when DIR is inside a worktree; falls back to DIR for plain copies
+# (the read-only verifiers must also work on non-git scratch replicas).
+repo_dir() {
+  local dir=$1 top
+  [ -d "$dir" ] || die "directory not found: $dir"
+  if command -v git >/dev/null 2>&1; then
+    top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)
+    if [ -n "$top" ] && [ -d "$top" ]; then echo "$top"; return 0; fi
+  fi
+  (cd "$dir" && pwd -P)
+}
+
+# git_repo_root DIR -> absolute top level of a real git checkout/worktree,
+# dying (not falling back) when DIR is not a git repository.
+git_repo_root() {
+  local dir=$1 top
+  command -v git >/dev/null 2>&1 || die "required command not found: git"
+  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)
+  [ -n "$top" ] || die "not a git repository or linked worktree: $dir (linked worktrees have a .git file; git -C must resolve it)"
+  [ -d "$top" ] || die "git reported a missing top level for $dir: $top"
+  echo "$top"
+}
+
+# copy_preserving SRC DST -> APFS clone when the filesystem supports it
+# (copy-on-write, cheap for the ~639 MiB model files), else a byte copy.
+# A clone is a real independent file: later writes/renames cannot modify SRC.
+copy_preserving() {
+  local src=$1 dst=$2
+  cp -c -p "$src" "$dst" >/dev/null 2>&1 && return 0
+  cp -p "$src" "$dst"
+}
+
+count_literal() { # file literal -> occurrence count
+  local file=$1 lit=$2
+  if [ ! -f "$file" ]; then echo 0; return 0; fi
+  grep -F -o -- "$lit" "$file" 2>/dev/null | wc -l | tr -d ' '
+}
+
+count_in_pins() { # repo literal -> total occurrences across the six pin files
+  local repo=$1 lit=$2 total=0 f n
+  for f in $PIN_FILES; do
+    n=$(count_literal "$repo/$f" "$lit")
+    total=$((total + n))
+  done
+  echo "$total"
+}
+
+pins_state() { # repo -> new | old | mixed | missing
+  local repo=$1 f
+  for f in $PIN_FILES; do
+    if [ ! -f "$repo/$f" ]; then echo missing; return 0; fi
+  done
+  local na ne nd nj nv nt oa oe od oj ov ot nse nsd ose osd
+  na=$(count_in_pins "$repo" "$NEW_ARCHIVE_SHA256")
+  ne=$(count_in_pins "$repo" "$NEW_ENCODER_SHA256")
+  nd=$(count_in_pins "$repo" "$NEW_DECODER_SHA256")
+  nj=$(count_in_pins "$repo" "$NEW_JOINER_SHA256")
+  nv=$(count_in_pins "$repo" "$NEW_MODEL_VERSION")
+  nt=$(count_in_pins "$repo" "$NEW_TOKENS_SHA256")
+  oa=$(count_in_pins "$repo" "$OLD_ARCHIVE_SHA256")
+  oe=$(count_in_pins "$repo" "$OLD_ENCODER_SHA256")
+  od=$(count_in_pins "$repo" "$OLD_DECODER_SHA256")
+  oj=$(count_in_pins "$repo" "$OLD_JOINER_SHA256")
+  ov=$(count_in_pins "$repo" "$OLD_MODEL_VERSION")
+  ot=$(count_in_pins "$repo" "$OLD_TOKENS_SHA256")
+  nse=$(count_in_pins "$repo" "${NEW_ENCODER_SIZE}L")
+  nsd=$(count_in_pins "$repo" "${NEW_DECODER_SIZE}L")
+  ose=$(count_in_pins "$repo" "${OLD_ENCODER_SIZE}L")
+  osd=$(count_in_pins "$repo" "${OLD_DECODER_SIZE}L")
+  local new_ok=0 old_ok=0
+  if [ "$na" = "$PIN_COUNT_ARCHIVE" ] && [ "$ne" = "$PIN_COUNT_MEMBER" ] && [ "$nd" = "$PIN_COUNT_MEMBER" ] &&
+     [ "$nj" = "$PIN_COUNT_MEMBER" ] && [ "$nt" = "$PIN_COUNT_MEMBER" ] && [ "$nv" = "$PIN_COUNT_MODEL_VERSION" ] &&
+     [ "$nse" = "$PIN_COUNT_SIZE" ] && [ "$nsd" = "$PIN_COUNT_SIZE" ] &&
+     [ "$oa" = 0 ] && [ "$oe" = 0 ] && [ "$od" = 0 ] && [ "$oj" = 0 ] && [ "$ov" = 0 ]; then new_ok=1; fi
+  if [ "$na" = 0 ] && [ "$ne" = 0 ] && [ "$nd" = 0 ] && [ "$nj" = 0 ] && [ "$nv" = 0 ] &&
+     [ "$oa" = "$PIN_COUNT_ARCHIVE" ] && [ "$oe" = "$PIN_COUNT_MEMBER" ] && [ "$od" = "$PIN_COUNT_MEMBER" ] &&
+     [ "$oj" = "$PIN_COUNT_MEMBER" ] && [ "$ot" = "$PIN_COUNT_MEMBER" ] && [ "$ov" = "$PIN_COUNT_MODEL_VERSION" ] &&
+     [ "$ose" = "$PIN_COUNT_SIZE" ] && [ "$osd" = "$PIN_COUNT_SIZE" ] &&
+     [ "$nse" = 0 ] && [ "$nsd" = 0 ]; then old_ok=1; fi
+  if [ "$new_ok" = 1 ]; then echo new
+  elif [ "$old_ok" = 1 ]; then echo old
+  else echo mixed; fi
+}
+
+pins_table() { # repo -> human-readable literal counts (label count)
+  local repo=$1
+  echo "new_archive=$(count_in_pins "$repo" "$NEW_ARCHIVE_SHA256")"
+  echo "new_encoder=$(count_in_pins "$repo" "$NEW_ENCODER_SHA256")"
+  echo "new_decoder=$(count_in_pins "$repo" "$NEW_DECODER_SHA256")"
+  echo "new_joiner=$(count_in_pins "$repo" "$NEW_JOINER_SHA256")"
+  echo "new_model_version=$(count_in_pins "$repo" "$NEW_MODEL_VERSION")"
+  echo "old_archive=$(count_in_pins "$repo" "$OLD_ARCHIVE_SHA256")"
+  echo "old_encoder=$(count_in_pins "$repo" "$OLD_ENCODER_SHA256")"
+  echo "old_decoder=$(count_in_pins "$repo" "$OLD_DECODER_SHA256")"
+  echo "old_joiner=$(count_in_pins "$repo" "$OLD_JOINER_SHA256")"
+  echo "old_model_version=$(count_in_pins "$repo" "$OLD_MODEL_VERSION")"
+  echo "tokens=$(count_in_pins "$repo" "$NEW_TOKENS_SHA256")"
+  echo "new_encoder_size=$(count_in_pins "$repo" "${NEW_ENCODER_SIZE}L")"
+  echo "new_decoder_size=$(count_in_pins "$repo" "${NEW_DECODER_SIZE}L")"
+  echo "old_encoder_size=$(count_in_pins "$repo" "${OLD_ENCODER_SIZE}L")"
+  echo "old_decoder_size=$(count_in_pins "$repo" "${OLD_DECODER_SIZE}L")"
+}
+
+staged_class() { # staging-dir -> new | old | mixed | missing
+  local dir=$1 f h
+  local new_hits=0 old_hits=0 missing=0 other=0
+  for f in $MODEL_FILES; do
+    if [ ! -f "$dir/$f" ]; then missing=1; continue; fi
+    h=$(sha256_file "$dir/$f")
+    case "$f" in
+      encoder.int8.onnx)
+        if [ "$h" = "$NEW_ENCODER_SHA256" ]; then new_hits=$((new_hits + 1));
+        elif [ "$h" = "$OLD_ENCODER_SHA256" ]; then old_hits=$((old_hits + 1)); else other=1; fi ;;
+      decoder.int8.onnx)
+        if [ "$h" = "$NEW_DECODER_SHA256" ]; then new_hits=$((new_hits + 1));
+        elif [ "$h" = "$OLD_DECODER_SHA256" ]; then old_hits=$((old_hits + 1)); else other=1; fi ;;
+      joiner.int8.onnx)
+        if [ "$h" = "$NEW_JOINER_SHA256" ]; then new_hits=$((new_hits + 1));
+        elif [ "$h" = "$OLD_JOINER_SHA256" ]; then old_hits=$((old_hits + 1)); else other=1; fi ;;
+      tokens.txt)
+        # tokens.txt is byte-identical in the OLD and NEW archives: it must not
+        # influence the OLD/NEW class, only prove it is one of the two.
+        if [ "$h" != "$NEW_TOKENS_SHA256" ] && [ "$h" != "$OLD_TOKENS_SHA256" ]; then other=1; fi ;;
+    esac
+  done
+  if [ "$missing" = 1 ]; then echo missing
+  elif [ "$other" = 1 ]; then echo mixed
+  elif [ "$new_hits" = 3 ] && [ "$old_hits" = 0 ]; then echo new
+  elif [ "$old_hits" = 3 ] && [ "$new_hits" = 0 ]; then echo old
+  else echo mixed; fi
+}
+
+staged_report() { # staging-dir -> per-file hash/size/class
+  local dir=$1 f h s
+  for f in $MODEL_FILES; do
+    if [ ! -f "$dir/$f" ]; then echo "$f missing - -"; continue; fi
+    h=$(sha256_file "$dir/$f")
+    s=$(file_size "$dir/$f")
+    local cls=other
+    case "$f" in
+      encoder.int8.onnx)
+        if [ "$h" = "$NEW_ENCODER_SHA256" ]; then cls=new; elif [ "$h" = "$OLD_ENCODER_SHA256" ]; then cls=old; fi ;;
+      decoder.int8.onnx)
+        if [ "$h" = "$NEW_DECODER_SHA256" ]; then cls=new; elif [ "$h" = "$OLD_DECODER_SHA256" ]; then cls=old; fi ;;
+      joiner.int8.onnx)
+        if [ "$h" = "$NEW_JOINER_SHA256" ]; then cls=new; elif [ "$h" = "$OLD_JOINER_SHA256" ]; then cls=old; fi ;;
+      tokens.txt)
+        if [ "$h" = "$NEW_TOKENS_SHA256" ] || [ "$h" = "$OLD_TOKENS_SHA256" ]; then cls=shared; fi ;;
+    esac
+    echo "$f $s $h $cls"
+  done
+}
+
+# ---- per-file canonical values (Plan B per-file transaction support) -------
+
+new_sha() { case "$1" in
+  encoder.int8.onnx) echo "$NEW_ENCODER_SHA256" ;;
+  decoder.int8.onnx) echo "$NEW_DECODER_SHA256" ;;
+  joiner.int8.onnx) echo "$NEW_JOINER_SHA256" ;;
+  tokens.txt) echo "$NEW_TOKENS_SHA256" ;;
+  *) echo "" ;; esac; }
+
+new_size() { case "$1" in
+  encoder.int8.onnx) echo "$NEW_ENCODER_SIZE" ;;
+  decoder.int8.onnx) echo "$NEW_DECODER_SIZE" ;;
+  joiner.int8.onnx) echo "$NEW_JOINER_SIZE" ;;
+  tokens.txt) echo "$NEW_TOKENS_SIZE" ;;
+  *) echo "" ;; esac; }
+
+old_sha() { case "$1" in
+  encoder.int8.onnx) echo "$OLD_ENCODER_SHA256" ;;
+  decoder.int8.onnx) echo "$OLD_DECODER_SHA256" ;;
+  joiner.int8.onnx) echo "$OLD_JOINER_SHA256" ;;
+  tokens.txt) echo "$OLD_TOKENS_SHA256" ;;
+  *) echo "" ;; esac; }
+
+old_size() { case "$1" in
+  encoder.int8.onnx) echo "$OLD_ENCODER_SIZE" ;;
+  decoder.int8.onnx) echo "$OLD_DECODER_SIZE" ;;
+  joiner.int8.onnx) echo "$OLD_JOINER_SIZE" ;;
+  tokens.txt) echo "$OLD_TOKENS_SIZE" ;;
+  *) echo "" ;; esac; }
+
+# file_state DIR FILE -> new | old | shared | other | missing
+# "shared" is returned for tokens.txt, whose bytes are identical in both states.
+file_state() {
+  local dir=$1 f=$2 h
+  if [ ! -e "$dir/$f" ]; then echo missing; return 0; fi
+  if [ ! -f "$dir/$f" ]; then echo other; return 0; fi
+  h=$(sha256_file "$dir/$f")
+  case "$f" in
+    encoder.int8.onnx)
+      if [ "$h" = "$NEW_ENCODER_SHA256" ]; then echo new; return 0; fi
+      if [ "$h" = "$OLD_ENCODER_SHA256" ]; then echo old; return 0; fi ;;
+    decoder.int8.onnx)
+      if [ "$h" = "$NEW_DECODER_SHA256" ]; then echo new; return 0; fi
+      if [ "$h" = "$OLD_DECODER_SHA256" ]; then echo old; return 0; fi ;;
+    joiner.int8.onnx)
+      if [ "$h" = "$NEW_JOINER_SHA256" ]; then echo new; return 0; fi
+      if [ "$h" = "$OLD_JOINER_SHA256" ]; then echo old; return 0; fi ;;
+    tokens.txt)
+      if [ "$h" = "$NEW_TOKENS_SHA256" ] || [ "$h" = "$OLD_TOKENS_SHA256" ]; then echo shared; return 0; fi ;;
+  esac
+  echo other
+}
+
+check_archives() { # verifies both archives size+sha; logs PASS/FAIL
+  if [ -f "$OLD_ARCHIVE" ]; then
+    check_eq "old archive size" "$OLD_ARCHIVE_SIZE" "$(file_size "$OLD_ARCHIVE")"
+    check_eq "old archive sha256" "$OLD_ARCHIVE_SHA256" "$(sha256_file "$OLD_ARCHIVE")"
+  else
+    fail "old archive present ($OLD_ARCHIVE)"
+  fi
+  if [ -f "$NEW_ARCHIVE" ]; then
+    check_eq "new archive size" "$NEW_ARCHIVE_SIZE" "$(file_size "$NEW_ARCHIVE")"
+    check_eq "new archive sha256" "$NEW_ARCHIVE_SHA256" "$(sha256_file "$NEW_ARCHIVE")"
+  else
+    fail "new archive present ($NEW_ARCHIVE)"
+  fi
+}
+
+summary() {
+  echo "----------------------------------------"
+  echo "checks passed: $PASS_COUNT   failed: $FAIL_COUNT"
+  if [ "$FAIL_COUNT" -ne 0 ]; then return 1; fi
+  return 0
+}
+
+# ---------------------------------------------------------------------------
+# Plan B backup layout helpers (defects B1/B2/B3).
+#
+# v2 layout:
+#   BACKUP_DIR/BACKUP-PROVENANCE.txt
+#   BACKUP_DIR/targets.tsv                       id <TAB> target path <TAB> pre-class
+#   BACKUP_DIR/targets/<id>/backup-manifest.tsv  file <TAB> pre_state <TAB> size <TAB> sha256
+#   BACKUP_DIR/targets/<id>/<file>               backed-up pre-existing bytes
+#
+# legacy layout (round 4): BACKUP_DIR/backup-manifest.tsv (file size sha) +
+# flat files; only a single target and only pre_state=new rows.
+# ---------------------------------------------------------------------------
+
+backup_layout() { # backup-dir -> v2 | legacy | none
+  local b=$1
+  if [ -f "$b/$BACKUP_TARGETS_TSV" ]; then echo v2; return 0; fi
+  if [ -f "$b/backup-manifest.tsv" ]; then echo legacy; return 0; fi
+  echo none
+}
+
+backup_provenance_get() { # backup-dir key -> value (empty when absent)
+  local b=$1 k=$2
+  [ -f "$b/$BACKUP_PROVENANCE_FILE" ] || return 0
+  grep "^$k=" "$b/$BACKUP_PROVENANCE_FILE" 2>/dev/null | head -1 | cut -d= -f2-
+}
+
+backup_target_dir() { # backup-dir target-id -> directory holding that target's backup
+  local b=$1 tid=$2 layout
+  layout=$(backup_layout "$b")
+  if [ "$layout" = v2 ]; then echo "$b/targets/$tid"; else echo "$b"; fi
+}
+
+backup_target_manifest() { # backup-dir target-id -> manifest path
+  echo "$(backup_target_dir "$1" "$2")/$BACKUP_TARGET_MANIFEST"
+}
+
+backup_read_targets() { # backup-dir -> id<TAB>path<TAB>pre_class lines (v2 only)
+  local b=$1
+  [ "$(backup_layout "$b")" = v2 ] || return 0
+  grep -v '^#' "$b/$BACKUP_TARGETS_TSV" 2>/dev/null | grep -v '^[[:space:]]*$' || true
+}
+
+backup_target_count() { # backup-dir -> number of recorded targets
+  local b=$1 n=0
+  if [ "$(backup_layout "$b")" = v2 ]; then
+    n=$(backup_read_targets "$b" | wc -l | tr -d ' ')
+  elif [ "$(backup_layout "$b")" = legacy ]; then
+    n=1
+  fi
+  echo "$n"
+}
+
+# backup_check_provenance BACKUP_DIR -> 0 ok, 1 bad; prints issue lines.
+backup_check_provenance() {
+  local b=$1 layout issues=0 fmt count actual rec tid path pre
+  if [ ! -f "$b/$BACKUP_PROVENANCE_FILE" ]; then
+    echo "missing provenance: $b/$BACKUP_PROVENANCE_FILE"; return 1
+  fi
+  layout=$(backup_layout "$b")
+  if [ "$layout" = none ]; then
+    echo "backup dir has neither targets.tsv nor backup-manifest.tsv"; return 1
+  fi
+  if [ "$layout" = legacy ]; then
+    for k in created_utc source_repo plan_script old_archive_sha256 new_archive_sha256; do
+      if [ -z "$(backup_provenance_get "$b" "$k")" ]; then echo "legacy provenance missing $k"; issues=$((issues + 1)); fi
+    done
+    [ "$issues" = 0 ] && return 0
+    return 1
+  fi
+  fmt=$(backup_provenance_get "$b" format_version)
+  if [ "$fmt" != "$BACKUP_FORMAT_VERSION" ]; then
+    echo "provenance format_version '$fmt' != '$BACKUP_FORMAT_VERSION'"; issues=$((issues + 1))
+  fi
+  if [ ! -f "$b/$BACKUP_TARGETS_TSV" ]; then
+    echo "missing targets.tsv"; issues=$((issues + 1))
+  else
+    actual=$(sha256_file "$b/$BACKUP_TARGETS_TSV")
+    rec=$(backup_provenance_get "$b" targets_tsv_sha256)
+    if [ -z "$rec" ]; then echo "provenance missing targets_tsv_sha256"; issues=$((issues + 1))
+    elif [ "$rec" != "$actual" ]; then echo "targets.tsv sha256 mismatch (stale/tampered manifest)"; issues=$((issues + 1)); fi
+  fi
+  count=$(backup_provenance_get "$b" target_count)
+  actual=$(backup_target_count "$b")
+  if [ -z "$count" ]; then echo "provenance missing target_count"; issues=$((issues + 1))
+  elif [ "$count" != "$actual" ]; then echo "provenance target_count $count != recorded $actual"; issues=$((issues + 1)); fi
+  while IFS=$'\t' read -r tid path pre; do
+    [ -n "$tid" ] || continue
+    if [ -z "$path" ] || [ -z "$pre" ]; then
+      echo "malformed targets.tsv line: $tid"; issues=$((issues + 1)); continue
+    fi
+    rec=$(backup_provenance_get "$b" "manifest_sha256_$tid")
+    if [ -z "$rec" ]; then
+      echo "provenance missing manifest_sha256_$tid"; issues=$((issues + 1)); continue
+    fi
+    if [ ! -f "$(backup_target_manifest "$b" "$tid")" ]; then
+      echo "missing manifest for target $tid"; issues=$((issues + 1)); continue
+    fi
+    actual=$(sha256_file "$(backup_target_manifest "$b" "$tid")")
+    if [ "$rec" != "$actual" ]; then
+      echo "manifest sha256 mismatch for target $tid (stale/tampered manifest)"; issues=$((issues + 1))
+    fi
+  done <<EOF
+$(backup_read_targets "$b")
+EOF
+  if [ "$issues" -ne 0 ]; then return 1; fi
+  return 0
+}
+
+# backup_check_manifest BACKUP_DIR TARGET_ID -> 0 ok, 1 bad; prints issues.
+# Validates: file names, pre_state values, duplicates, per-file size/hash against
+# the canonical NEW values, no unlisted/missing backup files.
+backup_check_manifest() {
+  local b=$1 tid=$2 layout tdir manifest f pre size sha extra issues=0 seen=" " m found
+  layout=$(backup_layout "$b")
+  tdir=$(backup_target_dir "$b" "$tid")
+  manifest="$tdir/$BACKUP_TARGET_MANIFEST"
+  if [ ! -f "$manifest" ]; then echo "missing manifest: $manifest"; return 1; fi
+  if [ "$layout" = v2 ]; then
+    while IFS=$'\t' read -r f pre size sha extra; do
+      [ -n "$f" ] || continue
+      case "$f" in \#*) continue ;; esac
+      found=0
+      for m in $MODEL_FILES; do [ "$m" = "$f" ] && found=1; done
+      if [ "$found" != 1 ]; then echo "manifest lists unknown file: $f"; issues=$((issues + 1)); continue; fi
+      case "$seen" in *" $f "*) echo "duplicate manifest entry: $f"; issues=$((issues + 1)); continue ;; esac
+      seen="$seen$f "
+      case "$pre" in
+        new)
+          if [ "$size" != "$(new_size "$f")" ]; then echo "$f manifest size $size != canonical $(new_size "$f")"; issues=$((issues + 1)); fi
+          if [ "$sha" != "$(new_sha "$f")" ]; then echo "$f manifest sha256 != canonical NEW digest"; issues=$((issues + 1)); fi
+          if [ ! -f "$tdir/$f" ]; then echo "backup file missing: $f"; issues=$((issues + 1));
+          else
+            if [ "$(file_size "$tdir/$f")" != "$(new_size "$f")" ]; then echo "$f backup size mismatch"; issues=$((issues + 1)); fi
+            if [ "$(sha256_file "$tdir/$f")" != "$(new_sha "$f")" ]; then echo "$f backup sha256 mismatch (stale/tampered backup)"; issues=$((issues + 1)); fi
+          fi ;;
+        missing)
+          if [ -e "$tdir/$f" ]; then echo "backup file present although pre_state=missing: $f"; issues=$((issues + 1)); fi ;;
+        *) echo "invalid pre_state '$pre' for $f"; issues=$((issues + 1)) ;;
+      esac
+    done < "$manifest"
+  else
+    while IFS=$'\t' read -r f size sha extra; do
+      [ -n "$f" ] || continue
+      case "$f" in \#*) continue ;; esac
+      found=0
+      for m in $MODEL_FILES; do [ "$m" = "$f" ] && found=1; done
+      if [ "$found" != 1 ]; then echo "manifest lists unknown file: $f"; issues=$((issues + 1)); continue; fi
+      case "$seen" in *" $f "*) echo "duplicate manifest entry: $f"; issues=$((issues + 1)); continue ;; esac
+      seen="$seen$f "
+      if [ "$size" != "$(new_size "$f")" ]; then echo "$f manifest size $size != canonical $(new_size "$f")"; issues=$((issues + 1)); fi
+      if [ "$sha" != "$(new_sha "$f")" ]; then echo "$f manifest sha256 != canonical NEW digest"; issues=$((issues + 1)); fi
+      if [ ! -f "$tdir/$f" ]; then echo "backup file missing: $f"; issues=$((issues + 1));
+      else
+        if [ "$(file_size "$tdir/$f")" != "$(new_size "$f")" ]; then echo "$f backup size mismatch"; issues=$((issues + 1)); fi
+        if [ "$(sha256_file "$tdir/$f")" != "$(new_sha "$f")" ]; then echo "$f backup sha256 mismatch (stale/tampered backup)"; issues=$((issues + 1)); fi
+      fi
+    done < "$manifest"
+  fi
+  # Every model file that exists in the backup dir must be listed; no strays.
+  for m in $MODEL_FILES; do
+    if [ -e "$tdir/$m" ]; then
+      case "$seen" in *" $m "*) : ;; *) echo "unlisted backup file: $m"; issues=$((issues + 1)) ;; esac
+    fi
+  done
+  for f in "$tdir"/*; do
+    [ -e "$f" ] || continue
+    [ -f "$f" ] || continue
+    m=$(basename "$f")
+    [ "$m" = "$BACKUP_TARGET_MANIFEST" ] && continue
+    case " $MODEL_FILES " in *" $m "*) : ;; *) echo "unexpected file in backup dir: $m"; issues=$((issues + 1)) ;; esac
+  done
+  if [ "$seen" = " " ]; then echo "manifest has no entries"; issues=$((issues + 1)); fi
+  if [ "$issues" -ne 0 ]; then return 1; fi
+  return 0
+}
+
+# backup_check_tree BACKUP_DIR [TARGET_ID...] -> 0 ok; prints issue lines.
+# Cross-checks provenance, targets, manifests and bytes. With no target ids it
+# checks every recorded target.
+backup_check_tree() {
+  local b=$1 issues=0 tid rest ids="" target
+  shift || true
+  if [ "$#" -gt 0 ]; then ids="$*"; else
+    if [ "$(backup_layout "$b")" = v2 ]; then
+      while IFS=$'\t' read -r tid rest; do [ -n "$tid" ] && ids="$ids $tid"; done <<EOF
+$(backup_read_targets "$b")
+EOF
+    else
+      ids="t1"
+    fi
+  fi
+  backup_check_provenance "$b" || issues=$((issues + 1))
+  for target in $ids; do
+    backup_check_manifest "$b" "$target" || issues=$((issues + 1))
+  done
+  if [ "$issues" -ne 0 ]; then return 1; fi
+  return 0
+}
diff --git a/tools/plan-remediation/refresh-evidence-manifest.sh b/tools/plan-remediation/refresh-evidence-manifest.sh
new file mode 100755
index 0000000..2971c67
--- /dev/null
+++ b/tools/plan-remediation/refresh-evidence-manifest.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# Regenerate or verify a SHA-256 evidence manifest for a reviewable bundle.
+#
+# Why this exists (defect A4): the round 4 evidence manifest
+# archive/reports/round4-b-evidence-20261118/SHA256SUMS.txt went stale after
+# plans-lib.sh was fixed (it still recorded 73520f6e...), listed files that did
+# not exist in its directory, omitted the regeneration log, and contained a
+# self-entry whose hash can never be correct. This tool makes the manifest a
+# reproducible artifact instead of a hand-maintained snapshot:
+#   * it is generated from the actual bytes (never edited by hand);
+#   * it lists every regular file under the bundle root, so omissions fail;
+#   * it never lists itself (self-hash is impossible);
+#   * --check fails on a missing/stale/tampered manifest and prints a diff.
+#
+# Usage:
+#   ./refresh-evidence-manifest.sh [--check] [--name NAME] DIR
+#
+# Default NAME is SHA256SUMS. --check exits 0 when current, 1 when stale/missing.
+set -euo pipefail
+
+CHECK=0
+NAME=SHA256SUMS
+DIR=""
+
+usage() { sed -n '2,22p' "$0"; exit 2; }
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --check) CHECK=1; shift ;;
+    --name) NAME=$2; shift 2 ;;
+    -h|--help) usage ;;
+    -*) die "unknown option: $1" ;;
+    *) DIR=$1; shift ;;
+  esac
+done
+
+[ -n "$DIR" ] || die "DIR is required"
+[ -d "$DIR" ] || die "not a directory: $DIR"
+case "$NAME" in
+  */*|.|..) die "--name must be a plain file name" ;;
+esac
+
+DIR=$(cd "$DIR" && pwd -P)
+MANIFEST="$DIR/$NAME"
+TMP=$(mktemp "${TMPDIR:-/tmp}/evidence-sums.XXXXXX") || die "mktemp failed"
+trap 'rm -f "$TMP"' EXIT
+
+# Every regular file under the bundle root, excluding the manifest itself, in a
+# stable C-locale order. (Bundles are text/evidence trees; no .git directories
+# are expected. Excluding .git keeps the tool usable on a checkout.)
+(
+  cd "$DIR"
+  find . -type f ! -name "$NAME" ! -path './.git/*' -print | LC_ALL=C sort
+) > "$TMP.list" || die "file enumeration failed"
+
+COUNT=0
+: > "$TMP"
+while IFS= read -r f; do
+  [ -n "$f" ] || continue
+  if [ ! -f "$DIR/$f" ]; then die "listed path disappeared: $f"; fi
+  # Hash with a path relative to the bundle root so the manifest is portable
+  # (shasum -c must work from $DIR, not just on the machine that wrote it).
+  ( cd "$DIR" && shasum -a 256 "$f" ) >> "$TMP"
+  COUNT=$((COUNT + 1))
+done < "$TMP.list"
+rm -f "$TMP.list"
+
+if [ "$COUNT" = 0 ]; then
+  die "no files found under $DIR (refusing to write an empty manifest)"
+fi
+# Guard against a stale manifest listing itself.
+if [ -f "$MANIFEST" ] && grep -q -E "[[:space:]]\./$NAME$" "$MANIFEST" 2>/dev/null; then
+  if [ "$CHECK" = 1 ]; then
+    echo "STALE: $NAME lists itself (self-hash is impossible)" >&2
+    exit 1
+  fi
+fi
+if grep -q -E "[[:space:]]\./$NAME$" "$TMP" 2>/dev/null; then
+  die "internal error: generated manifest lists itself"
+fi
+
+if [ "$CHECK" = 1 ]; then
+  if [ ! -f "$MANIFEST" ]; then
+    echo "STALE: manifest missing: $MANIFEST" >&2
+    echo "run: $0 $DIR (without --check) to regenerate it" >&2
+    exit 1
+  fi
+  if cmp -s "$TMP" "$MANIFEST"; then
+    echo "OK: $NAME is current ($COUNT files)"
+    exit 0
+  fi
+  echo "STALE: $MANIFEST does not match the current tree ($COUNT files)" >&2
+  echo "--- differences (generated vs recorded; - expected, + recorded) ---" >&2
+  diff -u "$MANIFEST" "$TMP" 2>/dev/null | sed -n '1,80p' >&2 || true
+  exit 1
+fi
+
+mv -f "$TMP" "$MANIFEST" || die "cannot write manifest: $MANIFEST"
+trap - EXIT
+echo "WROTE: $MANIFEST ($COUNT files)"
diff --git a/tools/plan-remediation/restore-staged-backup.sh b/tools/plan-remediation/restore-staged-backup.sh
new file mode 100755
index 0000000..22bac9f
--- /dev/null
+++ b/tools/plan-remediation/restore-staged-backup.sh
@@ -0,0 +1,394 @@
+#!/usr/bin/env bash
+# Reverse Plan B -- restore the pre-Plan-B staged model bytes (normally the NEW
+# bytes backed up by apply-plan-b.sh). DRY-RUN BY DEFAULT.
+#
+# Remediation copy (Round 7, agent B) fixes:
+#   B1  restores every target recorded in BACKUP_DIR/targets.tsv, including the
+#       negative worktree via --include-negative, instead of silently restoring
+#       only one staging dir. Per-file hash verification against the manifest
+#       (or the canonical NEW digests for recovery sources) is mandatory.
+#   B2  pre-stage all bytes + verify, then commit renames; current bytes are
+#       saved first so a commit failure can be rolled back.
+#   B3  alternate recovery sources: --source backup (default; exact pre-state,
+#       including removing files that were absent before Plan B),
+#       --source extracted-new, --source archive (force a consistent NEW set).
+#   A4  stale/tampered backup manifests are refused (provenance pins the
+#       targets.tsv and per-target manifest sha256 values).
+#
+# Usage:
+#   ./restore-staged-backup.sh --backup-dir DIR [--repo DIR] [--staging DIR]
+#                              [--source backup|extracted-new|archive]
+#                              [--include-negative] [--apply] [--idempotent]
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd -P)
+. "$HERE/parakeet-pins.env"
+. "$HERE/plans-lib.sh"
+
+REPO=$REPO_ROOT
+STAGING=$STAGING_DIR
+BACKUP_DIR=""
+SOURCE=backup
+APPLY=0
+IDEMPOTENT=0
+INCLUDE_NEGATIVE=0
+
+WORK=""
+TMP_FILES=""
+PRE_FILES=""
+COMMIT_STARTED=0
+TARGET_IDS=()
+TARGET_PATHS=()
+TARGET_SRCS=()
+
+usage() { sed -n '2,28p' "$0"; exit 2; }
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --repo) REPO=$2; shift 2 ;;
+    --staging) STAGING=$2; shift 2 ;;
+    --backup-dir) BACKUP_DIR=$2; shift 2 ;;
+    --source) SOURCE=$2; shift 2 ;;
+    --apply) APPLY=1; shift ;;
+    --idempotent) IDEMPOTENT=1; shift ;;
+    --include-negative) INCLUDE_NEGATIVE=1; shift ;;
+    -h|--help) usage ;;
+    *) die "unknown argument: $1" ;;
+  esac
+done
+
+require_cmd shasum
+require_cmd grep
+[ -n "$BACKUP_DIR" ] || die "--backup-dir is required"
+[ -d "$BACKUP_DIR" ] || die "backup dir not found: $BACKUP_DIR"
+LAYOUT=$(backup_layout "$BACKUP_DIR")
+[ "$LAYOUT" != none ] || die "backup dir is not a Plan B backup (no targets.tsv/backup-manifest.tsv): $BACKUP_DIR"
+
+WORK=$(mktemp -d "${TMPDIR:-/tmp}/r7-plan-b-restore.XXXXXX") || die "mktemp failed"
+
+cleanup_on_exit() {
+  local rc=$? t
+  for t in $TMP_FILES; do rm -f "$t" 2>/dev/null || true; done
+  for t in $PRE_FILES; do rm -f "$t" 2>/dev/null || true; done
+  if [ -n "$WORK" ] && [ -d "$WORK" ]; then rm -rf "$WORK" 2>/dev/null || true; fi
+  exit "$rc"
+}
+trap cleanup_on_exit EXIT
+
+remove_tmp_path() { # path
+  local p=$1 out="" t
+  for t in $TMP_FILES; do [ "$t" = "$p" ] || out="$out $t"; done
+  TMP_FILES=$out
+}
+
+STAGING=$(cd "$STAGING" 2>/dev/null && pwd -P) || STAGING=$STAGING
+
+log "Reverse Plan B preflight (mode: $([ "$APPLY" = 1 ] && echo APPLY || echo DRY-RUN), source: $SOURCE)"
+
+# ---------------------------------------------------------------------------
+# 1. Validate the backup itself (manifests + backed-up bytes) for the backup
+#    source; for alternate sources the manifests are still the target record.
+# ---------------------------------------------------------------------------
+if ! detail=$(backup_check_tree "$BACKUP_DIR" 2>&1); then
+  printf '%s\n' "$detail" | sed 's/^/      /'
+  die "backup is stale/tampered/incomplete; refusing to restore from it"
+fi
+log "backup provenance, targets and per-target manifests verified"
+
+# 2. Build the target list (v2 multi-target or legacy single-target).
+if [ "$LAYOUT" = v2 ]; then
+  ROWS=$(backup_read_targets "$BACKUP_DIR")
+  COUNT=$(backup_target_count "$BACKUP_DIR")
+  [ -n "$ROWS" ] || die "targets.tsv records no targets"
+  MAIN_ID=""
+  MAIN_PATH=""
+  OTHER_ID=""
+  OTHER_PATH=""
+  while IFS=$'\t' read -r tid path pre; do
+    [ -n "$tid" ] || continue
+    if [ "$path" = "$STAGING" ]; then
+      MAIN_ID=$tid; MAIN_PATH=$path
+    else
+      if [ -n "$OTHER_ID" ]; then die "backup records more than two targets; refusing (unsupported layout)"; fi
+      OTHER_ID=$tid; OTHER_PATH=$path
+    fi
+  done <<EOF
+$ROWS
+EOF
+  if [ -z "$MAIN_ID" ]; then
+    if [ "$COUNT" = 1 ]; then
+      while IFS=$'\t' read -r tid path pre; do [ -n "$tid" ] || continue; MAIN_ID=$tid; MAIN_PATH=$path; done <<EOF
+$ROWS
+EOF
+      warn "--staging $STAGING does not match the recorded target $MAIN_PATH; using the recorded target"
+    else
+      die "backup records targets but none matches --staging $STAGING; pass the recorded path (see $BACKUP_DIR/$BACKUP_TARGETS_TSV)"
+    fi
+  fi
+  if [ -n "$OTHER_ID" ]; then
+    if [ "$INCLUDE_NEGATIVE" != 1 ]; then
+      die "backup records a second target ($OTHER_PATH); re-run with --include-negative to restore all recorded targets"
+    fi
+    TARGET_IDS+=("$MAIN_ID"); TARGET_PATHS+=("$MAIN_PATH")
+    TARGET_IDS+=("$OTHER_ID"); TARGET_PATHS+=("$OTHER_PATH")
+  else
+    if [ "$INCLUDE_NEGATIVE" = 1 ]; then
+      die "backup has no second (negative) target; drop --include-negative"
+    fi
+    TARGET_IDS+=("$MAIN_ID"); TARGET_PATHS+=("$MAIN_PATH")
+  fi
+else
+  # legacy flat backup: one target, positional --staging.
+  if [ "$INCLUDE_NEGATIVE" = 1 ]; then
+    die "legacy (round 4) backup has no negative target record; --include-negative is not reversible for it"
+  fi
+  TARGET_IDS+=("t1"); TARGET_PATHS+=("$STAGING")
+fi
+log "targets: ${#TARGET_PATHS[@]} (main $STAGING)"
+
+# ---------------------------------------------------------------------------
+# 3. Resolve the recovery source.
+# ---------------------------------------------------------------------------
+case "$SOURCE" in
+  backup)
+    log "source bytes: the verified backup (exact pre-Plan-B state)"
+    ;;
+  extracted-new)
+    [ -d "$NEW_EXTRACTED" ] || die "extracted-new directory missing: $NEW_EXTRACTED"
+    for f in $MODEL_FILES; do
+      [ -f "$NEW_EXTRACTED/$f" ] || die "recovery source missing: $NEW_EXTRACTED/$f"
+      check_eq "recovery source $f size" "$(new_size "$f")" "$(file_size "$NEW_EXTRACTED/$f")"
+      check_eq "recovery source $f sha256" "$(new_sha "$f")" "$(sha256_file "$NEW_EXTRACTED/$f")"
+    done
+    [ "$FAIL_COUNT" = 0 ] || die "extracted-new recovery source does not match canonical NEW bytes"
+    PASS_COUNT=0; FAIL_COUNT=0
+    ;;
+  archive)
+    log "extracting NEW archive to $WORK (read-only recovery source)"
+    tar -xjf "$NEW_ARCHIVE" -C "$WORK" || die "new archive extraction failed"
+    NEW_EXTRACTED="$WORK/$ARCHIVE_MEMBER_DIR"
+    for f in $MODEL_FILES; do
+      [ -f "$NEW_EXTRACTED/$f" ] || die "recovery source missing: $NEW_EXTRACTED/$f"
+      check_eq "recovery source $f size" "$(new_size "$f")" "$(file_size "$NEW_EXTRACTED/$f")"
+      check_eq "recovery source $f sha256" "$(new_sha "$f")" "$(sha256_file "$NEW_EXTRACTED/$f")"
+    done
+    [ "$FAIL_COUNT" = 0 ] || die "archive recovery source does not match canonical NEW bytes"
+    PASS_COUNT=0; FAIL_COUNT=0
+    ;;
+  *) die "--source must be backup, extracted-new or archive" ;;
+esac
+
+# ---------------------------------------------------------------------------
+# 4. Build the per-file action plan.
+#    backup source  -> restore manifest pre_state: new = write recorded bytes,
+#                      missing = remove the file Plan B installed.
+#    other sources  -> force every model file to its canonical NEW bytes.
+# ---------------------------------------------------------------------------
+PLAN_TSV="$WORK/restore-plan.tsv"
+: > "$PLAN_TSV"
+ANY_WRITE=0
+i=0
+while [ "$i" -lt "${#TARGET_PATHS[@]}" ]; do
+  tid=${TARGET_IDS[$i]}
+  tp=${TARGET_PATHS[$i]}
+  if [ ! -d "$tp" ]; then warn "target dir does not exist: $tp"; fi
+  if [ "$SOURCE" = backup ]; then
+    tdir=$(backup_target_dir "$BACKUP_DIR" "$tid")
+    manifest="$tdir/$BACKUP_TARGET_MANIFEST"
+    if [ "$LAYOUT" = legacy ]; then tdir="$BACKUP_DIR"; manifest="$BACKUP_DIR/backup-manifest.tsv"; fi
+    while IFS=$'\t' read -r f pre size sha extra; do
+      [ -n "$f" ] || continue
+      case "$f" in \#*) continue ;; esac
+      if [ "$LAYOUT" != v2 ]; then sha=$size; size=$pre; pre=new; fi
+      case "$pre" in
+        new)
+          if [ -f "$tp/$f" ] && [ "$(sha256_file "$tp/$f")" = "$sha" ]; then
+            act=skip
+          else
+            act=write
+          fi
+          printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$tid" "$tp" "$f" "$act" "$size" "$sha" >> "$PLAN_TSV"
+          ;;
+        missing)
+          if [ -e "$tp/$f" ]; then act=remove; else act=skip; fi
+          printf '%s\t%s\t%s\t%s\t-\t-\n' "$tid" "$tp" "$f" "$act" >> "$PLAN_TSV"
+          ;;
+        *) die "invalid pre_state '$pre' in $manifest" ;;
+      esac
+      [ "$act" = skip ] || ANY_WRITE=1
+    done < "$manifest"
+  else
+    for f in $MODEL_FILES; do
+      st=missing
+      if [ -e "$tp/$f" ]; then st=$(file_state "$tp" "$f"); fi
+      case "$st" in
+        new|shared) act=skip ;;
+        old|missing) act=write ;;
+        *) warn "target $tp file $f holds unknown bytes; recovery source will overwrite it"; act=write ;;
+      esac
+      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$tid" "$tp" "$f" "$act" "$(new_size "$f")" "$(new_sha "$f")" >> "$PLAN_TSV"
+      [ "$act" = skip ] || ANY_WRITE=1
+    done
+  fi
+  i=$((i + 1))
+done
+
+echo
+echo "== Planned reverse-Plan-B change =="
+echo "backup dir    $BACKUP_DIR"
+echo "source        $SOURCE"
+echo "mode          $([ "$APPLY" = 1 ] && echo APPLY || echo DRY-RUN)"
+i=0
+while [ "$i" -lt "${#TARGET_PATHS[@]}" ]; do
+  echo "target        ${TARGET_IDS[$i]} ${TARGET_PATHS[$i]} (state $(staged_class "${TARGET_PATHS[$i]}"))"
+  i=$((i + 1))
+done
+echo "actions       $(grep -c -v 'skip$' "$PLAN_TSV" || true) write/remove, $(grep -c 'skip$' "$PLAN_TSV" || true) skip"
+echo
+
+if [ "$ANY_WRITE" = 0 ]; then
+  if [ "$IDEMPOTENT" = 1 ]; then
+    log "targets already match the requested source state; --idempotent given, verifying only"
+    APPLY=0
+  else
+    die "targets already match the requested source state; pass --idempotent to verify only"
+  fi
+fi
+
+if [ "$APPLY" -ne 1 ]; then
+  echo "DRY-RUN OK: backup/source verified and action plan built; no files were written."
+  echo "Re-run with --apply to restore the staged bytes."
+  exit 0
+fi
+
+# ---------------------------------------------------------------------------
+# 5. Pre-stage every write, saving current bytes for commit rollback.
+# ---------------------------------------------------------------------------
+while IFS=$'\t' read -r tid tp f act size sha; do
+  [ -n "$f" ] || continue
+  [ "$act" = skip ] && continue
+  mkdir -p "$tp" || die "cannot create target dir: $tp"
+  if [ "$act" = remove ]; then
+    # save the current file for rollback, but stage no replacement
+    presave="$WORK/pre.$tid.$f"
+    copy_preserving "$tp/$f" "$presave" || die "cannot save current bytes: $tp/$f"
+    PRE_FILES="$PRE_FILES $presave"
+    continue
+  fi
+  if [ "$SOURCE" = backup ]; then
+    src_file="$(backup_target_dir "$BACKUP_DIR" "$tid")/$f"
+    if [ "$LAYOUT" = legacy ]; then src_file="$BACKUP_DIR/$f"; fi
+  else
+    src_file="$NEW_EXTRACTED/$f"
+  fi
+  [ -f "$src_file" ] || die "source file missing: $src_file"
+  if [ -e "$tp/$f" ]; then
+    presave="$WORK/pre.$tid.$f"
+    copy_preserving "$tp/$f" "$presave" || die "cannot save current bytes: $tp/$f"
+    PRE_FILES="$PRE_FILES $presave"
+  fi
+  tmp="$tp/.plan-b-restore-tmp.$$.$f"
+  copy_preserving "$src_file" "$tmp" || die "pre-stage copy failed: $src_file -> $tmp"
+  TMP_FILES="$TMP_FILES $tmp"
+  got=$(sha256_file "$tmp")
+  if [ "$got" != "$sha" ] || [ "$(file_size "$tmp")" != "$size" ]; then
+    die "pre-staged $f hash/size mismatch (got $got); no destination was touched"
+  fi
+done < "$PLAN_TSV"
+log "pre-staged and hash-verified every replacement; destination bytes saved for rollback"
+
+restore_commit_rollback() {
+  local tid tp f act size sha presave ok=1
+  warn "commit failure: restoring the pre-restore bytes saved in $WORK"
+  while IFS=$'\t' read -r tid tp f act size sha; do
+    [ -n "$f" ] || continue
+    [ "$act" = skip ] && continue
+    presave="$WORK/pre.$tid.$f"
+    if [ -f "$presave" ]; then
+      cp -p "$presave" "$tp/.plan-b-restore-rb.$f" 2>/dev/null || { ok=0; continue; }
+      mv -f "$tp/.plan-b-restore-rb.$f" "$tp/$f" || ok=0
+    else
+      rm -f "$tp/$f"
+    fi
+  done < "$PLAN_TSV"
+  [ "$ok" = 1 ] || warn "rollback incomplete; re-run this script with --apply to converge"
+}
+
+# 6. Commit the renames/removals; roll back on failure.
+COMMIT_STARTED=1
+while IFS=$'\t' read -r tid tp f act size sha; do
+  [ -n "$f" ] || continue
+  [ "$act" = skip ] && continue
+  if [ "$act" = remove ]; then
+    if ! rm -f "$tp/$f"; then
+      restore_commit_rollback
+      die "failed to remove $tp/$f"
+    fi
+    log "  removed $f (was absent before Plan B)"
+    continue
+  fi
+  tmp="$tp/.plan-b-restore-tmp.$$.$f"
+  if ! mv -f "$tmp" "$tp/$f"; then
+    restore_commit_rollback
+    die "rename failed: $tmp -> $tp/$f"
+  fi
+  remove_tmp_path "$tmp"
+  got=$(sha256_file "$tp/$f")
+  if [ "$got" != "$sha" ]; then
+    restore_commit_rollback
+    die "restored $f hash mismatch after rename"
+  fi
+  log "  restored $f"
+done < "$PLAN_TSV"
+COMMIT_STARTED=0
+
+# ---------------------------------------------------------------------------
+# 7. Verify the final state byte-for-byte against the requested source.
+# ---------------------------------------------------------------------------
+FAILED=0
+i=0
+while [ "$i" -lt "${#TARGET_PATHS[@]}" ]; do
+  tid=${TARGET_IDS[$i]}
+  tp=${TARGET_PATHS[$i]}
+  if [ "$SOURCE" = backup ]; then
+    tdir=$(backup_target_dir "$BACKUP_DIR" "$tid")
+    manifest="$tdir/$BACKUP_TARGET_MANIFEST"
+    if [ "$LAYOUT" = legacy ]; then
+      tdir="$BACKUP_DIR"
+      manifest="$BACKUP_DIR/backup-manifest.tsv"
+    fi
+    while IFS=$'\t' read -r f pre size sha extra; do
+      [ -n "$f" ] || continue
+      case "$f" in \#*) continue ;; esac
+      if [ "$LAYOUT" != v2 ]; then sha=$size; size=$pre; pre=new; fi
+      case "$pre" in
+        new)
+          if [ ! -f "$tp/$f" ] || [ "$(sha256_file "$tp/$f")" != "$sha" ]; then
+            warn "post-restore mismatch: $tp/$f"; FAILED=$((FAILED + 1))
+          fi ;;
+        missing)
+          if [ -e "$tp/$f" ]; then warn "post-restore file should be absent: $tp/$f"; FAILED=$((FAILED + 1)); fi ;;
+      esac
+    done < "$manifest"
+  else
+    if [ "$(staged_class "$tp")" != new ]; then
+      warn "post-restore target is not a consistent NEW set: $tp"
+      staged_report "$tp" | sed 's/^/      /'
+      FAILED=$((FAILED + 1))
+    fi
+  fi
+  i=$((i + 1))
+done
+
+if [ "$FAILED" -ne 0 ]; then
+  die "reverse Plan B verification failed ($FAILED target/file mismatches)"
+fi
+
+echo
+echo "OK: staged bytes restored from source '$SOURCE' for ${#TARGET_PATHS[@]} target(s)."
+echo "Backup retained at $BACKUP_DIR (can be removed once Plan A pins are applied and the"
+echo "old archive is preserved; keep it until the owner-gated window closes)."
+if [ "$SOURCE" = backup ]; then
+  echo "State: pre-Plan-B hazard (pins OLD + staged NEW) unless Plan A pins are applied."
+else
+  echo "State: staged NEW (hazard with OLD pins; run apply-plan-a.sh under an approved window)."
+fi
diff --git a/tools/plan-remediation/tests/test-lib.sh b/tools/plan-remediation/tests/test-lib.sh
new file mode 100755
index 0000000..f8dc619
--- /dev/null
+++ b/tools/plan-remediation/tests/test-lib.sh
@@ -0,0 +1,125 @@
+#!/usr/bin/env bash
+# Shared harness for the Round 7 Plan A/B remediation regression suites.
+set -uo pipefail
+TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
+KIT=$(cd "$TEST_DIR/.." && pwd -P)
+. "$KIT/parakeet-pins.env"
+. "$KIT/plans-lib.sh"
+TEST_PASS=0
+TEST_FAIL=0
+t_pass() { TEST_PASS=$((TEST_PASS + 1)); echo "T-PASS  $*"; }
+t_fail() { TEST_FAIL=$((TEST_FAIL + 1)); echo "T-FAIL  $*"; }
+t_info() { echo "T-INFO  $*"; }
+TEST_SUITE=${TEST_SUITE:-misc}
+ROOT=${PLANS_TEST_ROOT:-$T5/cache/round7/plans/test-run}
+SCRATCH="$ROOT/$TEST_SUITE"
+LOGS="$SCRATCH/logs"
+suite_setup() {
+  rm -rf "$SCRATCH"
+  mkdir -p "$SCRATCH" "$LOGS"
+}
+
+require_fixtures() {
+  local ok=1
+  [ -f "$OLD_ARCHIVE" ] || { t_fail "fixture missing: $OLD_ARCHIVE"; ok=0; }
+  [ -f "$NEW_ARCHIVE" ] || { t_fail "fixture missing: $NEW_ARCHIVE"; ok=0; }
+  [ -d "$OLD_EXTRACTED" ] || { t_fail "fixture missing: $OLD_EXTRACTED"; ok=0; }
+  [ -d "$NEW_EXTRACTED" ] || { t_fail "fixture missing: $NEW_EXTRACTED"; ok=0; }
+  [ "$ok" = 1 ] || { echo "SUITE RESULT: pass=$TEST_PASS fail=$TEST_FAIL"; exit 1; }
+}
+run_expect_ok() {
+  local desc=$1 lf=$2; shift 2
+  if "$@" >"$lf" 2>&1; then t_pass "$desc"; else
+    t_fail "$desc (exit $?; see $lf)"
+    tail -5 "$lf" | sed 's/^/    /'
+  fi
+}
+run_expect_fail() {
+  local desc=$1 lf=$2; shift 2
+  if "$@" >"$lf" 2>&1; then
+    t_fail "$desc (unexpectedly succeeded; see $lf)"
+  else
+    t_pass "$desc"
+  fi
+}
+assert_eq() { if [ "$2" = "$3" ]; then t_pass "$1"; else t_fail "$1 (expected '$2', got '$3')"; fi }
+assert_file() { if [ -f "$2" ]; then t_pass "$1"; else t_fail "$1 (missing $2)"; fi }
+assert_absent() { if [ ! -e "$2" ]; then t_pass "$1"; else t_fail "$1 (unexpectedly present: $2)"; fi }
+assert_grep() { if grep -q -E "$2" "$3" 2>/dev/null; then t_pass "$1"; else t_fail "$1 (pattern '$2' not in $3)"; fi }
+log_counts() { awk '/checks passed:/ {print $3, $5; found=1} END {if (!found) print "0 0"}' "$1"; }
+assert_counts() {
+  local got p f
+  got=$(log_counts "$2"); p=${got% *}; f=${got#* }
+  if [ "$p" = "$3" ] && [ "$f" = "$4" ]; then t_pass "$1 ($p passed / $f failed)"; else t_fail "$1 (expected $3/$4, log says $p/$f)"; fi
+}
+hash_set() {
+  local dir=$1 out=$2 f
+  : > "$out"
+  ( cd "$dir" 2>/dev/null || { for f in $MODEL_FILES; do echo "MISSING  $f"; done > "$out"; exit 0; }
+    for f in $MODEL_FILES; do
+      if [ -f "$f" ]; then shasum -a 256 "$f"; else echo "MISSING  $f"; fi
+    done > "$out" )
+}
+hash_pin_files() {
+  local repo=$1 out=$2 f
+  : > "$out"
+  ( cd "$repo" || exit 1; for f in $PIN_FILES; do shasum -a 256 "$f" >> "$out"; done )
+}
+assert_same_bytes() {
+  if cmp -s "$2" "$3"; then t_pass "$1"; else t_fail "$1 (byte sets differ)"; diff "$2" "$3" | sed -n '1,10p' | sed 's/^/    /'; fi
+}
+assert_pins_old() {
+  local st; st=$(pins_state "$2")
+  if [ "$st" = old ]; then t_pass "$1 (pins OLD)"; else t_fail "$1 (pins '$st')"; fi
+}
+
+make_pin_repo() {
+  local dst=$1 f src
+  src=${PIN_SOURCE_REPO:-$REPO_ROOT}
+  mkdir -p "$dst"
+  for f in $PIN_FILES; do
+    mkdir -p "$dst/$(dirname "$f")"
+    cp -p "$src/$f" "$dst/$f"
+  done
+  git -C "$dst" init -q
+  git -C "$dst" add -A
+  git -C "$dst" -c user.email=plan@test -c user.name=plan commit -q -m "scratch old-pin baseline"
+}
+clone_model_dir() {
+  local src=$1 dst=$2 f
+  mkdir -p "$dst"
+  for f in $MODEL_FILES; do
+    copy_preserving "$src/$f" "$dst/$f" || { t_fail "clone failed: $src/$f"; return 1; }
+  done
+}
+new_staging() { clone_model_dir "$NEW_EXTRACTED" "$1"; }
+old_staging() { clone_model_dir "$OLD_EXTRACTED" "$1"; }
+make_fake_kit() {
+  local dst=$1
+  rm -rf "$dst"
+  cp -R "$KIT" "$dst"
+  chmod +x "$dst"/*.sh
+}
+make_mv_shim() {
+  local dir=$1
+  mkdir -p "$dir"
+  cat > "$dir/mv" <<'SHIM'
+#!/bin/sh
+countfile=${MV_SHIM_COUNTER:-/tmp/mv-shim-count}
+c=0
+[ -f "$countfile" ] && c=$(cat "$countfile")
+c=$((c + 1))
+echo "$c" > "$countfile"
+if [ "$c" -eq "${MV_SHIM_FAIL_AT:-2}" ]; then
+  echo "mv: injected failure (test shim, invocation $c)" >&2
+  exit 1
+fi
+exec /bin/mv "$@"
+SHIM
+  chmod +x "$dir/mv"
+}
+suite_finish() {
+  echo
+  echo "SUITE RESULT ($TEST_SUITE): pass=$TEST_PASS fail=$TEST_FAIL"
+  [ "$TEST_FAIL" = 0 ]
+}
