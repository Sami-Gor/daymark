#!/usr/bin/env bash
# Canonical Parakeet model pin values for Round 4 Plan A (adoption) and Plan B
# (restore old staged assets). Read-only data file: defines variables only.
#
# Authority: T5 /Volumes/DaymarkWorkspace/Daymark. Values independently
# re-derived 2026-11-18 from the preserved old archive, the quarantined new
# archive, their tar members, and the staged bytes on disk
# (archive/reports/round4-b-evidence-20261118/).
#
# Usage:  . "$(dirname "$0")/parakeet-pins.env"

T5_DEFAULT="/Volumes/DaymarkWorkspace/Daymark"
if [ -z "${T5:-}" ]; then T5="$T5_DEFAULT"; fi

PLAN_ROOT="$T5/archive/reports/round4-b-plans"
REPO_ROOT="$T5/repositories/daymark"
STAGING_DIR="$REPO_ROOT/artifacts/weather-app/android/parakeet-assets/src/main/assets/parakeet"
NEGATIVE_STAGING_DIR="$T5/worktrees/negative/artifacts/weather-app/android/parakeet-assets/src/main/assets/parakeet"
QUARANTINE_DIR="$T5/quarantine/parakeet-20261118"
OLD_ARCHIVE="$T5/archive/assets/parakeet-preservation/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8.tar.bz2"
NEW_ARCHIVE="$QUARANTINE_DIR/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8.tar.bz2"
ARCHIVE_MEMBER_DIR="sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
OLD_EXTRACTED="$QUARANTINE_DIR/extracted-old/$ARCHIVE_MEMBER_DIR"
NEW_EXTRACTED="$QUARANTINE_DIR/extracted-new/$ARCHIVE_MEMBER_DIR"

# Commit the Plan A patch was generated against (repo HEAD at planning time).
PLAN_A_BASELINE_SHA="45d12748679fa67723e6a5b2d997eb7711f05c43"
PLAN_A_BASELINE_DESC="repositories/daymark 45d1274 (public/pr54-n1-error-propagation-release-v2)"

# Pin-bearing files, repo-relative.
PIN_FETCH="android/kokoro-poc/scripts/fetch-parakeet-assets.sh"
PIN_GRADLE="artifacts/weather-app/android/parakeet-assets/build.gradle"
PIN_JAVA="artifacts/weather-app/android/daymark-voice/src/main/java/io/github/sami_gor/daymark/voice/ParakeetModelAssets.java"
PIN_TEST="artifacts/weather-app/android/daymark-voice/src/test/java/io/github/sami_gor/daymark/voice/ParakeetModelAssetsTest.java"
PIN_NOTICES="THIRD-PARTY-NOTICES.md"
PIN_GUIDE="docs/release/reproducible-build-guide.md"
PIN_FILES="$PIN_FETCH $PIN_GRADLE $PIN_JAVA $PIN_TEST $PIN_NOTICES $PIN_GUIDE"

# ------- OLD (currently pinned everywhere; Plan B restores staged bytes) -------
OLD_ARCHIVE_SHA256="5793d0fd397c5778d2cf2126994d58e9d56b1be7c04d13c7a15bb1b4eafb16bf"
OLD_ENCODER_SHA256="acfc2b4456377e15d04f0243af540b7fe7c992f8d898d751cf134c3a55fd2247"
OLD_DECODER_SHA256="179e50c43d1a9de79c8a24149a2f9bac6eb5981823f2a2ed88d655b24248db4e"
OLD_JOINER_SHA256="3164c13fc2821009440d20fcb5fdc78bff28b4db2f8d0f0b329101719c0948b3"
OLD_TOKENS_SHA256="d58544679ea4bc6ac563d1f545eb7d474bd6cfa467f0a6e2c1dc1c7d37e3c35d"
OLD_ARCHIVE_SIZE=487170055
OLD_ENCODER_SIZE=652184281
OLD_DECODER_SIZE=11845275
OLD_JOINER_SIZE=6355277
OLD_TOKENS_SIZE=93939
OLD_MODEL_VERSION="parakeet-tdt-0.6b-v3-int8-sha256-1"

# ------- NEW (Plan A target; already the staged bytes) -------
NEW_ARCHIVE_SHA256="1495e91b59d7fc53ddca91f3431758ec99f8fa253fdb0e1e851be0f72b14b0f9"
NEW_ENCODER_SHA256="1afbe69c1ffdabee94755f42e4daf1d93549131a3da11356bda84fcef0f2c479"
NEW_DECODER_SHA256="0222a86147299d4dee90edf95b6d13827edb42ad8b7c9cf0b2582f030937c0b5"
NEW_JOINER_SHA256="cbd02f3696e9944970111fb439d9c3fd365a80374565f13f2b9c7007d253fc98"
