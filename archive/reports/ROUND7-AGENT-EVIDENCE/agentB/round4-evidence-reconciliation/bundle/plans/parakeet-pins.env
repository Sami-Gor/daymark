# Expected occurrence counts of each digest/version literal inside the six PIN_FILES
# (tokens.txt is byte-identical in both archives, so it appears in both states).
PIN_COUNT_ARCHIVE=4          # fetch 1 + notices 2 + guide 1
PIN_COUNT_MEMBER=5           # fetch/build.gradle/ParakeetModelAssets/notices/guide
PIN_COUNT_SIZE=2             # ParakeetModelAssets + ParakeetModelAssetsTest
PIN_COUNT_MODEL_VERSION=1

# Model file names, in ParakeetModelAssets order.
MODEL_FILES="encoder.int8.onnx decoder.int8.onnx joiner.int8.onnx tokens.txt"

# Plan artifacts (relative to PLAN_ROOT).
PLAN_A_PATCH_NAME="plan-a-adoption.patch"
PLAN_A_REVERT_PATCH_NAME="plan-a-revert.patch"
