# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# environment
.env
.env.*
!.env.example

# System Files
.DS_Store
Thumbs.db

# Local test/coverage output
/test-results/
/playwright-report/
/coverage/
*.local

# Internal audit/reports kept locally, not for publication
/SECURITY-AUDIT.md
/RELEASE-READINESS.md
/FINAL-SECURITY-AUDIT.md
/PUBLIC-REPO-READINESS.md

# Android signing material (future TWA work)
*.keystore
*.jks
keystore.properties
signing.properties
*.pem
*.p12

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# ZCode session state
.zcode/

# Android build state (keystores already covered above)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/*.apk
android/*.aab

# Signed release bundles uploaded to Google Play — never commit these.
# The bundle contains the upload certificate and the shipped application code.
/google-play-upload/
*.aab

# Google Services / Firebase configuration is environment-specific and may
# contain a client API key. Never commit it.
/google-services.json
**/google-services.json

# Local V2 test-build assets. These are large binary model payloads and
# recorded test audio and must never reach the public repository.
# The v2test source set is a local-only experiment and is not tracked in any
# branch; only the payload directories are excluded here, so that any source
# under src/v2test/ can still be committed deliberately if it is ever
# published deliberately.
/artifacts/weather-app/android/app/src/v2test/assets/
/artifacts/weather-app/android/app/libs/
/android/app/libs/

# Store-listing artwork held locally outside the tracked documentation tree.
/Images/
/Phone Assets/
/Android XR assets/
/Chromebook screenshots/
/10-inch tablet Assets/
/7-inch tablet Tablet assets/

# Kokoro POC build artifacts (external crate checkout + cargo/NDK leftovers)
android/kokoro-poc/.build/
android/.cargo/

# Kokoro POC generated inputs (fetch/build via android/kokoro-poc/scripts)
android/app/src/main/assets/kokoro/
android/app/src/main/jniLibs/
android/kokoro-poc/rust/target/
